---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import InfoCard from '../components/InfoCard.astro';
import Cta from '../components/Cta.astro';
import {
  PHONE_TEL,
  PHONE_DISPLAY,
  PHONE_TEL_2,
  PHONE_DISPLAY_2,
  WHATSAPP_URL,
  WHATSAPP_DISPLAY,
  ADDRESS_LINE,
  HOURS_DISPLAY,
  PLUS_CODE,
  MAPS_EMBED_URL,
} from '../consts.js';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where is Smart Cook Dera located?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Smart Cook Dera is on Sahiwal-Arifwala-Bahawalnagar Road, approximately 8 km from Arifwala city towards Sahiwal. Plus Code: 82MP+XWF',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Smart Cook Dera have a mosque?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Smart Cook Dera has a dedicated mosque within its premises with a resident Imam leading all five daily prayers. Open to all travellers and visitors.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is the food Halal?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. All food at Smart Cook Dera is fully Halal.' },
    },
    {
      '@type': 'Question',
      name: 'Is parking available at Smart Cook Dera?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Ample parking is available for cars, buses and trucks.' },
    },
    {
      '@type': 'Question',
      name: 'What food does Smart Cook Dera serve?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We serve fresh Karahi (mutton and chicken), BBQ including seekh kabab and boti, fresh tandoor roti and naan, fast food, chai, and cold drinks.',
      },
    },
  ],
});

const faqs = [
  { q: 'Where is Smart Cook Dera located?', a: 'Smart Cook Dera is on Sahiwal-Arifwala-Bahawalnagar Road, approximately 8 km from Arifwala city towards Sahiwal. Plus Code: 82MP+XWF' },
  { q: 'Does Smart Cook Dera have a mosque?', a: 'Yes. Smart Cook Dera has a dedicated mosque within its premises with a resident Imam leading all five daily prayers. Open to all travellers and visitors.' },
  { q: 'Is the food Halal?', a: 'Yes. All food at Smart Cook Dera is fully Halal.' },
  { q: 'Is parking available?', a: 'Yes. Ample parking is available for cars, buses and trucks.' },
  { q: 'What food is served?', a: 'We serve fresh Karahi (mutton and chicken), BBQ, fresh tandoor roti and naan, fast food, chai, and cold drinks.' },
];
---

<BaseLayout
  title="Contact Smart Cook Dera | Call or WhatsApp | Sahiwal-Arifwala Road"
  description="Contact Smart Cook Dera. Call or WhatsApp us directly. Located on Sahiwal-Arifwala Road near Arifwala. Open daily."
  schema={schema}
  headerVariant="utility"
>
  <section class="bg-brand-dark px-5 py-section-md md:px-10 lg:px-16">
    <div class="mx-auto max-w-6xl">
      <p class="font-mono text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-brand-accent">Get in touch</p>
      <h1 class="mt-3 font-display text-display font-medium leading-none text-brand-cream">Contact</h1>
      <p class="mt-4 max-w-md font-mono text-[0.62rem] uppercase leading-relaxed tracking-[0.16em] text-brand-cream/55">Call, WhatsApp, or drop by on the Sahiwal–Arifwala Road.</p>
    </div>
  </section>

  <section class="bg-brand-cream px-5 py-section-md md:px-10">
    <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
      <InfoCard
        icon='<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02l-2.2 2.2z"/></svg>'
        heading="Call Us"
        align="center"
      >
        <p class="font-mono text-2xl font-bold tracking-tight text-brand-accent">{PHONE_DISPLAY}</p>
        <p class="mt-1 text-brand-cream/60">
          or <a href={PHONE_TEL_2} class="underline hover:text-brand-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent">{PHONE_DISPLAY_2}</a>
        </p>
        <Cta href={PHONE_TEL} class="mt-5 w-full">Tap to Call</Cta>
      </InfoCard>

      <InfoCard
        icon='<svg width="28" height="28" viewBox="0 0 24 24" fill="#25D366"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.1c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.13.11-1.82-.12-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.16-4.94-4.35-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.26-.28.57-.35.76-.35h.55c.18 0 .42-.07.65.5.24.58.82 2 .89 2.15.07.14.11.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.14-.29.29-.12.57.17.28.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.33 1.44.28.14.44.12.61-.07.16-.19.7-.81.89-1.09.19-.28.37-.23.62-.14.26.09 1.63.77 1.91.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>'
        heading="WhatsApp"
        align="center"
      >
        <p class="font-mono text-2xl font-bold tracking-tight text-brand-accent">{WHATSAPP_DISPLAY}</p>
        <Cta href={WHATSAPP_URL} variant="whatsapp" target="_blank" rel="noopener noreferrer" class="mt-5 w-full">Open WhatsApp</Cta>
      </InfoCard>
    </div>
  </section>

  <section class="bg-brand-cream px-5 py-section-md md:px-10">
    <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3">
      <InfoCard
        icon='<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>'
        heading="Address"
      >
        <p>{ADDRESS_LINE}</p>
        <p class="mt-1 text-brand-cream/60">Plus Code: {PLUS_CODE}</p>
      </InfoCard>
      <InfoCard
        icon='<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>'
        heading="Opening Hours"
      >
        <p>{HOURS_DISPLAY}</p>
      </InfoCard>
      <InfoCard
        icon='<svg width="26" height="26" viewBox="0 0 40 40" fill="none"><path d="M11 34V21a9 9 0 0118 0v13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 34h26" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="20" cy="9" r="1.6" fill="currentColor"/></svg>'
        heading="Mosque on Premises"
      >
        <p>Dedicated mosque with Imam. All 5 daily prayers. Open to all visitors.</p>
        <a href="/prayer-facility" class="mt-1 inline-block text-brand-accent hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent">Learn more →</a>
      </InfoCard>
    </div>
  </section>

  <section class="bg-brand-green px-5 py-section-md text-center md:px-10">
    <h2 class="font-display text-2xl font-medium text-brand-cream">Had an issue with your visit?</h2>
    <p class="mx-auto mt-2 max-w-md text-brand-cream/70">We want to make it right. Call us directly and speak to the manager.</p>
    <Cta href={PHONE_TEL} variant="primary" class="mt-6">Call the Manager</Cta>
  </section>

  <div class="bg-brand-cream px-5 py-section-sm md:px-10 lg:px-20">
    <div class="mx-auto max-w-4xl overflow-hidden border border-brand-text-dark/15" data-media>
      <iframe
        src={MAPS_EMBED_URL}
        width="100%"
        height="350"
        class="block border-0"
        loading="lazy"
        title="Smart Cook Dera map"
      ></iframe>
    </div>
  </div>

  <section class="bg-brand-cream px-5 py-section-md md:px-10">
    <div class="mx-auto max-w-3xl">
      <SectionLabel label="FAQ" urdu="عمومی سوالات" />
      <h2 class="text-center font-display text-heading font-medium text-brand-text-dark">Common Questions</h2>
      <div class="mt-10 border-t border-brand-text-dark/15">
        {faqs.map((faq) => (
          <details class="group border-b border-brand-text-dark/15">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-lg font-medium text-brand-text-dark transition-colors group-open:text-brand-accent">
              {faq.q}
              <span class="font-mono text-brand-accent transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="pb-5 text-brand-text-muted">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
