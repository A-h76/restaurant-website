---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import InfoCard from '../components/InfoCard.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  PHONE_TEL,
  PHONE_DISPLAY,
  MAPS_DIRECTIONS_URL,
  MAPS_EMBED_URL,
  PLUS_CODE,
} from '../consts.js';

const carIcon = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M5 17a2 2 0 01-2-2v-1.5a1 1 0 01.14-.51L5.5 9.2A2 2 0 017.2 8h9.6a2 2 0 011.7 1.2l2.36 3.79a1 1 0 01.14.51V15a2 2 0 01-2 2M5 17a2 2 0 002 2h0a2 2 0 002-2M17 17a2 2 0 002 2h0a2 2 0 002-2M5 13h14"/></svg>';
---

<BaseLayout
  title="How to Find Smart Cook Dera | Sahiwal-Arifwala Road, Near Arifwala"
  description="Smart Cook Dera is on Sahiwal-Arifwala-Bahawalnagar Road, near Arifwala. Easy directions from Sahiwal and Arifwala. Parking for all vehicles. Plus Code: 82MP+XWF"
  headerVariant="utility"
>
  <PageHeader
    kicker="Directions"
    kickerUrdu="راستہ"
    title="Find Us"
    sub="Sahiwal–Arifwala–Bahawalnagar Road"
    meta={[PLUS_CODE, '8 km from Arifwala', 'Cars · Buses · Trucks']}
  />

  <section class="bg-brand-cream px-5 py-section-md md:px-10 lg:px-16">
    <div class="mx-auto max-w-6xl">
      <!-- Route diagram -->
      <div class="flex items-center gap-3 md:gap-5">
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-brand-text-muted">Sahiwal</span>
        <span class="relative flex-1">
          <span class="block h-px w-full origin-left bg-brand-text-dark/30" data-route-x></span>
          <span class="absolute left-1/2 top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-accent ring-4 ring-brand-cream"></span>
        </span>
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-brand-text-muted">Arifwala</span>
      </div>
      <p class="mt-3 text-center font-mono text-[0.62rem] uppercase tracking-[0.2em] text-brand-accent">◆ Smart Cook Dera</p>

      <div class="mt-12 max-w-md">
        <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-text-muted">Address</span>
        <p class="mt-2 font-display text-xl leading-relaxed text-brand-text-dark">
          Sahiwal-Arifwala-Bahawalnagar Road,<br />
          Arifwala, Pakpattan District, Punjab
        </p>
        <p class="mt-2 font-mono text-sm text-brand-text-muted" dir="ltr">Plus Code: {PLUS_CODE}</p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <Cta href={MAPS_DIRECTIONS_URL} variant="primary">Open in Google Maps</Cta>
        <Cta href={PHONE_TEL} variant="ghost" tone="dark">Call for Directions</Cta>
      </div>
    </div>
  </section>

  <section class="bg-brand-cream px-5 pb-section-md md:px-10 lg:px-20">
    <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
      <InfoCard icon={carIcon} heading="From Arifwala">
        Drive towards Sahiwal on Sahiwal-Arifwala Road. Smart Cook Dera is on this road. Watch for our highway sign.
      </InfoCard>
      <InfoCard icon={carIcon} heading="From Sahiwal">
        Drive towards Arifwala. Smart Cook Dera is before you reach Arifwala city. Watch for our highway sign.
      </InfoCard>
    </div>
  </section>

  <div class="bg-brand-cream px-5 pb-4 md:px-10 lg:px-20">
    <div class="mx-auto max-w-5xl overflow-hidden border border-brand-text-dark/15" data-media>
      <iframe
        src={MAPS_EMBED_URL}
        width="100%"
        height="450"
        class="block border-0"
        loading="lazy"
        title="Smart Cook Dera location map"
      ></iframe>
    </div>
  </div>

  <section class="bg-brand-cream px-5 py-section-sm text-center">
    <p class="inline-flex items-center gap-2 text-brand-text-dark">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C33F26" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14M5 17a2 2 0 01-2-2v-1.5a1 1 0 01.14-.51L5.5 9.2A2 2 0 017.2 8h9.6a2 2 0 011.7 1.2l2.36 3.79a1 1 0 01.14.51V15a2 2 0 01-2 2M5 17a2 2 0 002 2h0a2 2 0 002-2M17 17a2 2 0 002 2h0a2 2 0 002-2M5 13h14"/></svg>
      Parking available for cars, buses, and trucks.
    </p>
    <!-- TODO: Add nearby landmarks and villages for better findability -->
    <p class="mt-2 font-mono text-xs text-brand-text-muted">
      Landmark directions coming soon. Call us: <a href={PHONE_TEL} class="link-draw text-brand-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent">{PHONE_DISPLAY}</a>
    </p>
  </section>
</BaseLayout>
