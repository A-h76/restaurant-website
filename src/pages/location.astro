---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import InfoCard from '../components/InfoCard.astro';
import {
  PHONE_TEL,
  PHONE_DISPLAY,
  MAPS_DIRECTIONS_URL,
  MAPS_EMBED_URL,
  PLUS_CODE,
} from '../consts.js';

const carIcon = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M5 17a2 2 0 01-2-2v-1.5a1 1 0 01.14-.51L5.5 9.2A2 2 0 017.2 8h9.6a2 2 0 011.7 1.2l2.36 3.79a1 1 0 01.14.51V15a2 2 0 01-2 2M5 17a2 2 0 002 2h0a2 2 0 002-2M17 17a2 2 0 002 2h0a2 2 0 002-2M5 13h14"/></svg>';
---

<BaseLayout
  title="How to Find Smart Cook Dera | Sahiwal-Arifwala Road, Near Arifwala"
  description="Smart Cook Dera is on Sahiwal-Arifwala-Bahawalnagar Road, near Arifwala. Easy directions from Sahiwal and Arifwala. Parking for all vehicles. Plus Code: 82MP+XWF"
  headerVariant="utility"
>
  <section class="bg-brand-dark px-5 py-section-lg text-center">
    <h1 class="font-display text-heading font-semibold text-brand-cream">Find Us</h1>
    <p class="mt-2 font-sans text-sm uppercase tracking-widest text-brand-accent">Sahiwal–Arifwala–Bahawalnagar Road</p>
  </section>

  <section class="bg-brand-cream px-5 py-section-md text-center md:px-10">
    <h2 class="font-display text-2xl font-semibold text-brand-accent">Smart Cook Dera</h2>
    <p class="mt-4 font-sans text-brand-text-dark">
      Sahiwal-Arifwala-Bahawalnagar Road<br />
      Arifwala, Pakpattan District<br />
      Punjab, Pakistan<br />
      Plus Code: {PLUS_CODE}
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Cta href={MAPS_DIRECTIONS_URL}>Open in Google Maps</Cta>
      <Cta href={MAPS_DIRECTIONS_URL} variant="secondary">Get Directions</Cta>
      <Cta href={PHONE_TEL} variant="ghost" tone="dark">Call for Directions</Cta>
    </div>
  </section>

  <section class="bg-brand-cream px-5 pb-section-md md:px-10 lg:px-20">
    <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
      <InfoCard icon={carIcon} heading="From Arifwala">
        Drive towards Sahiwal on Sahiwal-Arifwala Road. Smart Cook Dera is on this road. Watch for our highway sign.
      </InfoCard>
      <InfoCard icon={carIcon} heading="From Sahiwal">
        Drive towards Arifwala. Smart Cook Dera is before you reach Arifwala city. Watch for our highway sign.
      </InfoCard>
    </div>
  </section>

  <div class="bg-brand-cream px-5 pb-4 md:px-10 lg:px-20">
    <div class="mx-auto max-w-5xl overflow-hidden rounded-[20px]">
      <iframe
        src={MAPS_EMBED_URL}
        width="100%"
        height="450"
        style="border:0; display: block;"
        loading="lazy"
        title="Smart Cook Dera location map"
      ></iframe>
    </div>
  </div>

  <section class="bg-brand-cream px-5 py-section-sm text-center">
    <p class="inline-flex items-center gap-2 font-sans text-brand-text-dark">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A84E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14M5 17a2 2 0 01-2-2v-1.5a1 1 0 01.14-.51L5.5 9.2A2 2 0 017.2 8h9.6a2 2 0 011.7 1.2l2.36 3.79a1 1 0 01.14.51V15a2 2 0 01-2 2M5 17a2 2 0 002 2h0a2 2 0 002-2M17 17a2 2 0 002 2h0a2 2 0 002-2M5 13h14"/></svg>
      Parking available for cars, buses, and trucks.
    </p>
    <!-- TODO: Add nearby landmarks and villages for better findability -->
    <p class="mt-2 font-sans text-sm text-brand-text-muted">
      Landmark directions coming soon. Call us: <a href={PHONE_TEL} class="text-brand-accent hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent">{PHONE_DISPLAY}</a>
    </p>
  </section>
</BaseLayout>
