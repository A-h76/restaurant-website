---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Stone from '../components/Stone.astro';
import DishImage from '../components/menu/DishImage.astro';
import FoodImage from '../components/FoodImage.astro';
import MenuItemModal from '../components/menu/MenuItemModal.astro';
import { findItem, formatPrice, priceSegments, isVerifiedImage } from '../lib/menu.js';
import { desiCategories, dealCategory } from '../data/menu-catalog.js';
import { PRAYERS } from '../lib/prayer.js';
import { PHONE_TEL, PHONE_DISPLAY, MAPS_DIRECTIONS_URL, MAPS_EMBED_URL, PLUS_CODE } from '../consts.js';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'LocalBusiness'],
  name: 'Smart Cook Dera',
  description:
    'Family restaurant on Sahiwal-Arifwala Road serving fresh Karahi, BBQ and Desi food. Dedicated mosque with Imam on premises. Near Arifwala.',
  url: 'https://smartcookdera.com',
  telephone: '+923056287676',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sahiwal-Arifwala-Bahawalnagar Road',
    addressLocality: 'Arifwala',
    addressRegion: 'Punjab',
    postalCode: '57450',
    addressCountry: 'PK',
  },
  servesCuisine: ['Pakistani', 'BBQ', 'Desi'],
  priceRange: '₨₨',
  hasMap: 'https://plus.codes/82MP+XWF',
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Prayer Facility', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Parking', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Family Seating', value: true },
  ],
  sameAs: ['https://www.facebook.com/smartcookdera'],
});

// ── Signature dishes (modal data contract identical to FoodCard/MenuItem) ──
const muttonKarahi = findItem(desiCategories, 'Mutton', 'Mutton Karahi');
const chickenKarahi = findItem(desiCategories, 'Chicken Karahi', 'Chicken Karahi');
const bbqMix = findItem(desiCategories, 'BBQ', 'BBQ Mix Platter');
const muttonKebab = findItem(desiCategories, 'BBQ', 'Mutton Kebab');
const biryani = findItem(desiCategories, 'Rice', 'Chicken Biryani');
const familyDeal = findItem([dealCategory], 'Deals', 'Deal A');

const seekhKabab = muttonKebab ? { ...muttonKebab, name: 'Seekh Kabab' } : null;
const featured = [muttonKarahi, chickenKarahi, seekhKabab, bbqMix, biryani, familyDeal].filter(Boolean);

// Parchi lines show ONE price: "from ₨X" when a dish has sizes (full list lives in the modal).
const featuredRows = featured.map((item) => {
  const verified = isVerifiedImage(item);
  const segs = priceSegments(item.price);
  const fromNote = item.note ? priceSegments(item.note)[0]?.price : '';
  const priceLabel = segs.length > 1 ? `from ${segs[0].price}` : item.price ? formatPrice(item.price) : fromNote ? `from ${fromNote}` : '';
  return { item, verified, priceLabel };
});

const ticker = [
  'Fresh Karahi', 'Charcoal BBQ', 'Handmade Naan', 'Mutton · Chicken',
  'Halal Kitchen', 'Mosque on Site', 'Family Seating', 'Truck & Bus Parking', 'Doodh Patti Chai',
];

const specs = [
  { k: 'Kitchen', v: '100% Halal' },
  { k: 'On site', v: 'Dedicated Mosque' },
  { k: 'Seating', v: 'Family & Private' },
  { k: 'Parking', v: 'Cars · Buses · Trucks' },
];

// ── The journey: five km stones, 8 → 0. Rail, eyebrows and dial all read from this. ──
const stops = [
  { id: 'hero', km: 8, label: 'Approach' },
  { id: 'dera', km: 6, label: 'The Dera' },
  { id: 'signature', km: 4, label: 'Signature' },
  { id: 'prayer', km: 2, label: 'Prayer' },
  { id: 'find', km: 0, label: 'Find us' },
];
const stopTop = ['top-0', 'top-1/4', 'top-1/2', 'top-3/4', 'top-full'];

// ── Speedometer geometry: 0 km at −120°, 8 km at +120° (clockwise from 12 o'clock). ──
const C = 120;
const pt = (deg, r) => {
  const a = (deg * Math.PI) / 180;
  return [C + r * Math.sin(a), C - r * Math.cos(a)];
};
const kmAngle = (km) => -120 + 30 * km;
const ticks = Array.from({ length: 17 }, (_, i) => {
  const major = i % 2 === 0;
  const [x1, y1] = pt(kmAngle(i / 2), major ? 90 : 97);
  const [x2, y2] = pt(kmAngle(i / 2), 105);
  return { x1, y1, x2, y2, major };
});
const labels = Array.from({ length: 9 }, (_, k) => {
  const [x, y] = pt(kmAngle(k), 76);
  return { k, x, y };
});
const arc = (a0, a1, r) => {
  const [x0, y0] = pt(a0, r);
  const [x1, y1] = pt(a1, r);
  return `M${x0.toFixed(2)} ${y0.toFixed(2)}A${r} ${r} 0 ${a1 - a0 > 180 ? 1 : 0} 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`;
};
---

<BaseLayout
  title="Smart Cook Dera | Restaurant & Mosque on Sahiwal-Arifwala Road | Near Arifwala"
  description="Family restaurant with a dedicated mosque on Sahiwal-Arifwala Road. Fresh Karahi, BBQ, family dining and parking. 8 km from Arifwala. Call now."
  schema={schema}
  headerVariant="utility"
  heroHeader
>
  <!-- ═══ KM RAIL (desktop): the page is the 8 km approach; the marker travels it ═══ -->
  <nav id="km-rail" aria-label="Page sections" class="fixed left-3 top-1/2 z-30 hidden -translate-y-[55%] lg:block xl:left-5">
    <div class="relative h-[50vh] w-10">
      <span class="absolute inset-y-0 left-1/2 -translate-x-1/2 border-l-2 border-dashed border-brand-accent/70" aria-hidden="true"></span>
      {stops.map((s, i) => (
        <a
          href={`#${s.id}`}
          data-km-stop={s.id}
          title={s.label}
          aria-label={`${s.label}, ${s.km} kilometres to go`}
          class={`stone absolute left-1/2 -translate-x-1/2 -translate-y-1/2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent ${stopTop[i]}`}
        >
          <small>km</small><b>{s.km}</b>
        </a>
      ))}
      <span data-km-marker class="pointer-events-none absolute left-[calc(50%+1.5rem)] top-0 -translate-y-1/2 border-y-[7px] border-r-[10px] border-y-transparent border-r-brand-accent" aria-hidden="true"></span>
    </div>
    <p class="mt-6 w-10 bg-brand-dark/90 py-1.5 text-center font-mono text-brand-cream" aria-hidden="true">
      <b data-km-readout class="block text-xs">8.0</b>
      <span class="text-[0.46rem] uppercase tracking-[0.08em]">km left</span>
    </p>
  </nav>

  <!-- KM PILL (mobile/tablet): same journey, one small chip -->
  <div id="km-pill" class="fixed left-3 z-30 bottom-[calc(5.625rem+env(safe-area-inset-bottom))] md:bottom-6 lg:hidden" aria-hidden="true">
    <div class="relative flex min-h-12 items-center gap-2.5 overflow-hidden border border-brand-cream/20 bg-brand-dark/95 px-3 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-brand-cream shadow-lg">
      <span class="stone !min-w-0 !px-1.5"><small>km</small><b data-km-now>8</b></span>
      <span data-km-label>Approach</span>
      <span data-km-bar class="absolute inset-x-0 bottom-0 h-0.5 origin-left bg-brand-accent"></span>
    </div>
  </div>

  <!-- ═══════════════ KM 8 — HERO: highway sign + speedometer + storefront ═══════════════ -->
  <section class="relative isolate overflow-hidden bg-brand-dark pt-16 md:pt-[4.75rem]" id="hero">
    <div class="grain pointer-events-none absolute inset-0 -z-10 opacity-[0.05] mix-blend-screen" aria-hidden="true"></div>

    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 border-b border-brand-cream/12 px-5 py-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-cream/60 md:px-10 lg:px-16">
      <span class="hero-in">Est. Roadside · Punjab</span>
      <span class="hero-in hidden sm:inline">Sahiwal — Arifwala Rd</span>
      <span class="hero-in" dir="ltr">{PLUS_CODE}</span>
    </div>

    <div class="mx-auto grid max-w-6xl gap-8 px-5 pb-8 pt-7 md:px-10 md:pt-9 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-14 lg:px-16 lg:pb-9">
      <div data-stagger="110">
        <div class="hero-in"><Stone km={8} label="Approaching the Dera" tone="dark" /></div>

        <!-- The sign -->
        <div class="hero-in relative mt-5 max-w-3xl rounded-2xl bg-brand-mid p-2 shadow-2xl ring-1 ring-brand-cream/10">
          <div class="relative rounded-xl border-2 border-brand-cream/90 px-5 py-6 sm:px-8 sm:py-7">
            <span class="absolute left-2.5 top-2.5 h-1.5 w-1.5 rounded-full bg-brand-cream/60" aria-hidden="true"></span>
            <span class="absolute right-2.5 top-2.5 h-1.5 w-1.5 rounded-full bg-brand-cream/60" aria-hidden="true"></span>
            <span class="absolute bottom-2.5 left-2.5 h-1.5 w-1.5 rounded-full bg-brand-cream/60" aria-hidden="true"></span>
            <span class="absolute bottom-2.5 right-2.5 h-1.5 w-1.5 rounded-full bg-brand-cream/60" aria-hidden="true"></span>

            <div class="flex items-center justify-between gap-4 font-mono text-[0.58rem] uppercase tracking-[0.22em] text-brand-cream/75 sm:text-[0.62rem]">
              <span>Family Restaurant</span>
              <span>Arifwala 8 km →</span>
            </div>
            <p class="mt-4 font-urdu-display text-2xl leading-tight text-marigold sm:text-4xl">سمارٹ کک ڈیرہ</p>
            <h1 class="mt-2 font-display text-[clamp(2.2rem,8vw,5.75rem)] font-semibold uppercase leading-[0.9] text-brand-cream">
              <span class="line-mask"><span>Smart Cook</span></span>
              <span class="line-mask"><span class="text-marigold">Dera</span></span>
            </h1>
            <p class="mt-5 border-t border-brand-cream/40 pt-3 font-mono text-[0.58rem] uppercase tracking-[0.2em] text-brand-cream/75 sm:text-[0.62rem]">
              Halal Kitchen · Charcoal BBQ · Mosque on Site
            </p>
          </div>
        </div>

        <p data-rise class="mt-6 max-w-xl font-display text-lg italic leading-relaxed text-brand-cream/85 md:text-xl">
          Good food, good rest — one memorable stop on the road between Sahiwal and Arifwala.
        </p>

        <div data-rise class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Cta href="/menu" variant="primary">View the Menu</Cta>
          <Cta href={MAPS_DIRECTIONS_URL} variant="ghost" tone="cream">Directions →</Cta>
        </div>
      </div>

      <!-- Speedometer: counts the km left as you scroll down the page -->
      <div class="hero-in relative mx-auto w-48 sm:w-56 lg:mx-0 lg:w-64">
        <svg viewBox="0 0 240 240" class="h-auto w-full" role="img" aria-label="Speedometer showing the distance left to the Dera, in kilometres">
          <circle cx="120" cy="120" r="117" fill="none" stroke="#D9A441" stroke-width="3" stroke-linecap="round" stroke-dasharray="0.1 7" />
          <circle cx="120" cy="120" r="111" fill="#2A241C" stroke="#E7E1D3" stroke-opacity="0.22" stroke-width="1.5" />
          <path d={arc(-120, 120, 108)} fill="none" stroke="#E7E1D3" stroke-opacity="0.18" stroke-width="3" />
          <path d={arc(-120, -90, 108)} fill="none" stroke="#D9A441" stroke-width="4" />
          {ticks.map((t) => (
            <line x1={t.x1.toFixed(2)} y1={t.y1.toFixed(2)} x2={t.x2.toFixed(2)} y2={t.y2.toFixed(2)} stroke="#E7E1D3" stroke-opacity={t.major ? 0.9 : 0.4} stroke-width={t.major ? 2 : 1.2} />
          ))}
          {labels.map((l) => (
            <text x={l.x.toFixed(2)} y={(l.y + 4).toFixed(2)} text-anchor="middle" font-size="11" class="fill-brand-cream/80 font-mono">{l.k}</text>
          ))}
          <text x="120" y="168" text-anchor="middle" font-size="9" letter-spacing="2.2" class="fill-brand-cream/60 font-mono">KM TO THE DERA</text>
          <text data-dial-readout x="120" y="196" text-anchor="middle" font-size="26" font-weight="700" class="fill-brand-cream font-mono">8.0</text>
          <g data-needle transform="rotate(120 120 120)">
            <polygon points="116.5,124 123.5,124 120,34" fill="#C33F26" />
            <polygon points="118.6,124 121.4,124 120,60" fill="#F1ECE0" fill-opacity="0.35" />
          </g>
          <circle cx="120" cy="120" r="9" fill="#1B1712" stroke="#D9A441" stroke-width="2" />
          <circle cx="120" cy="120" r="3" fill="#D9A441" />
        </svg>
      </div>
    </div>

    <!-- The storefront, uncropped: the night sky melts into the hero ground -->
    <div class="relative">
      <img
        src="/images/storefront.webp"
        srcset="/images/storefront-sm.webp 820w, /images/storefront.webp 1485w"
        sizes="100vw"
        alt="Smart Cook Dera family restaurant storefront lit up at night"
        width="1485"
        height="595"
        decoding="async"
        class="block aspect-[2/1] max-h-[58vh] w-full object-cover object-[center_45%] md:aspect-[5/2]"
      />
      <div class="pointer-events-none absolute inset-x-0 top-0 h-2/5 bg-gradient-to-b from-brand-dark to-transparent"></div>
    </div>
  </section>

  <!-- ═══════════════ TICKER + hanging fringe (truck-art jhalar) ═══════════════ -->
  <div class="marquee-host relative overflow-hidden border-y border-brand-dark bg-brand-accent py-3 text-brand-cream">
    <div class="marquee" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {ticker.map((t) => (
            <span class="flex items-center font-mono text-[0.72rem] font-semibold uppercase tracking-[0.16em]">
              <span class="px-6">{t}</span>
              <span class="text-marigold">✦</span>
            </span>
          ))}
        </div>
      ))}
    </div>
    <span class="sr-only">Fresh karahi, charcoal BBQ, handmade naan, halal kitchen, mosque on site, family seating and parking for trucks and buses.</span>
  </div>
  <div class="fringe" aria-hidden="true"></div>

  <!-- ═══════════════ KM 6 — THE DERA: statement + spec sheet ═══════════════ -->
  <section class="bg-brand-cream px-5 py-section-lg md:px-10 lg:px-16" id="dera">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
      <div data-stagger="90">
        <div data-rise><Stone km={6} label="The Dera" urdu="ڈیرہ" /></div>
        <h2 class="mt-5 font-display text-heading font-medium leading-[1.08] text-brand-text-dark">
          <span class="line-mask"><span>A roadside kitchen where</span></span>
          <span class="line-mask"><span>the karahi is fresh and</span></span>
          <span class="line-mask"><span>the stop is yours to keep.</span></span>
        </h2>
        <p data-rise class="mt-6 max-w-xl text-brand-text-muted">
          Between two towns, on a long highway, Smart Cook Dera is the place to pull over — bone-in mutton karahi from the iron pan, charcoal BBQ, hot naan straight off the tandoor, and a quiet mosque for prayer before you drive on.
        </p>
        <div data-rise class="mt-8">
          <Cta href="/menu" variant="secondary">Explore the Menu</Cta>
        </div>
      </div>

      <aside class="md:pt-1" data-stagger="70" aria-label="At a glance">
        <div class="mb-4 h-px w-full origin-left bg-brand-text-dark/20" data-route-x></div>
        {specs.map((s) => (
          <div data-rise class="flex items-baseline justify-between gap-4 border-b border-brand-text-dark/12 py-3.5">
            <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-brand-text-muted">{s.k}</span>
            <span class="text-right font-display text-lg font-medium text-brand-text-dark">{s.v}</span>
          </div>
        ))}
      </aside>
    </div>
  </section>

  <!-- ═══════════════ KM 4 — SIGNATURE: the dera parchi, heated by the tandoor ═══════════════ -->
  <section class="heat-section border-t border-brand-text-dark/10 px-5 py-section-lg md:px-10 lg:px-16" id="signature" data-heat>
    <div class="mx-auto max-w-6xl">
      <div data-rise><Stone km={4} label="Signature" urdu="خاص پکوان" /></div>
      <h2 data-rise class="mt-4 font-display text-display font-medium leading-none text-brand-text-dark">From the pan &amp; coals</h2>

      <div class="mt-14 grid items-start gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
        <!-- The parchi -->
        <div data-rise class="parchi bg-paper-bright pb-6 pt-7" id="parchi">
          <div class="flex items-start justify-between gap-4 px-5 md:px-8">
            <div>
              <p class="font-display text-3xl font-semibold uppercase leading-none tracking-wide text-brand-text-dark md:text-4xl">Dera Parchi</p>
              <p class="mt-2 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-text-muted">Today’s picks · tap a line to order</p>
            </div>
            <span class="mt-1 -rotate-12 shrink-0 select-none rounded-full border-2 border-brand-accent px-2 py-3 text-center font-mono text-[0.5rem] font-bold uppercase leading-tight tracking-[0.14em] text-brand-accent opacity-90 md:text-[0.56rem]" aria-hidden="true">
              Fresh<br />Halal<br />Daily
            </span>
          </div>

          <ol class="mt-6 border-t-2 border-dashed border-brand-text-dark/25" data-stagger="60">
            {featuredRows.map(({ item, verified, priceLabel }, i) => (
              <li data-rise class="border-b border-dashed border-brand-text-dark/15">
                <button
                  type="button"
                  data-menu-item
                  data-line
                  data-id={item.id ?? ''}
                  data-name={item.name}
                  data-category={item.category}
                  data-urdu={item.urdu ?? ''}
                  data-price={item.price ?? ''}
                  data-note={item.note ?? ''}
                  data-description={item.description ?? ''}
                  data-image={verified ? item.image : ''}
                  data-image-thumb={verified ? (item.imageThumb || item.image) : ''}
                  data-image-status={item.imageStatus ?? 'needs-review'}
                  data-image-fit={item.imageFit ?? 'cover'}
                  data-items={item.items ? item.items.join('||') : ''}
                  aria-haspopup="dialog"
                  class="group flex w-full items-center gap-3 px-5 py-3.5 text-left transition-colors hover:bg-brand-cream focus-visible:bg-brand-cream focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-accent md:gap-4 md:px-8"
                >
                  <span class="hidden w-6 shrink-0 font-mono text-xs text-brand-text-muted transition-colors group-hover:text-brand-accent sm:block">{String(i + 1).padStart(2, '0')}</span>

                  <!-- Mobile: every dish keeps its photo as a small polaroid -->
                  <span class="block h-14 w-[4.5rem] shrink-0 -rotate-2 bg-white p-1 shadow-sm lg:hidden">
                    <span class="block h-full w-full overflow-hidden bg-brand-dark">
                      <DishImage src={item.image} thumbSrc={item.imageThumb} alt="" verified={verified} sizes="72px" iconSize={20} fit={item.imageFit ?? 'cover'} />
                    </span>
                  </span>

                  <span class="min-w-0 flex-1 sm:flex-none">
                    <span class="flex flex-wrap items-baseline gap-x-3">
                      <span class="font-display text-lg font-medium leading-tight text-brand-text-dark md:text-2xl">{item.name}</span>
                      {item.urdu && <span class="font-urdu-display text-sm text-brand-text-muted" dir="rtl">{item.urdu}</span>}
                    </span>
                    <span class="mt-0.5 block font-mono text-[0.58rem] uppercase tracking-[0.16em] text-brand-text-muted">{item.category}</span>
                  </span>

                  <span class="leader mb-2 hidden min-w-6 flex-1 self-end sm:block" aria-hidden="true"></span>

                  {priceLabel && <span class="shrink-0 text-right font-mono text-[0.8rem] font-bold tabular-nums text-brand-text-dark md:text-sm" dir="ltr">{priceLabel}</span>}
                  <span class="hidden shrink-0 font-mono text-brand-accent transition-transform duration-200 group-hover:translate-x-1 md:inline" aria-hidden="true">→</span>
                </button>
              </li>
            ))}
          </ol>

          <div class="flex items-center justify-between gap-4 px-5 pt-5 md:px-8">
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.18em] text-brand-text-muted">Cooked to order · Mutton &amp; Chicken</p>
            <Cta href="/menu" variant="primary">Full Menu</Cta>
          </div>
        </div>

        <!-- Desktop stage: the dish lifts off the parchi as a polaroid -->
        <div class="hidden lg:sticky lg:top-28 lg:block" aria-hidden="true">
          <div class="mx-auto grid w-full max-w-sm">
            {featuredRows.map(({ item, verified, priceLabel }, i) => (
              <figure data-stage data-active={i === 0 ? '' : undefined} class="relative cursor-pointer bg-[#FBF8F0] p-3 pb-16 shadow-xl [grid-area:1/1]">
                <span class="absolute -top-3 left-1/2 h-6 w-24 -translate-x-1/2 -rotate-3 bg-marigold/70"></span>
                <div class="aspect-[4/3] overflow-hidden bg-brand-dark">
                  <DishImage src={item.image} thumbSrc={item.imageThumb} alt="" verified={verified} sizes="384px" iconSize={40} fit={item.imageFit ?? 'cover'} />
                </div>
                <figcaption class="absolute inset-x-4 bottom-4 flex items-baseline justify-between gap-3">
                  <span class="font-display text-xl italic leading-tight text-brand-text-dark">{item.name}</span>
                  {priceLabel && <span class="shrink-0 font-mono text-[0.7rem] font-bold text-brand-accent" dir="ltr">{priceLabel}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ KM 2 — PRAYER: the quiet register, aware of the hour ═══════════════ -->
  <section class="relative overflow-hidden bg-brand-green px-5 py-section-lg text-brand-cream md:px-10 lg:px-16" id="prayer" data-prayer-section>
    <div class="grain pointer-events-none absolute inset-0 opacity-[0.05] mix-blend-screen" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2 md:gap-16">
      <div data-stagger="90">
        <div data-rise><Stone km={2} label="On the premises" urdu="احاطے میں" tone="dark" /></div>
        <h2 class="mt-5 font-display text-display font-medium leading-[1.05]">
          <span class="line-mask"><span>A mosque for</span></span>
          <span class="line-mask"><span>the traveller.</span></span>
        </h2>
        <p data-rise class="mt-6 max-w-md leading-relaxed text-brand-cream/75">
          Not a prayer corner — a dedicated mosque with a resident Imam leading all five daily prayers. Stop, pray in congregation, and continue your journey with a fresh meal.
        </p>

        <!-- Live prayer panel: filled in by JS, hidden without it -->
        <div data-prayer-panel hidden class="mt-8 max-w-md border border-brand-cream/20 bg-brand-dark/35 p-5">
