---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import DishImage from '../components/menu/DishImage.astro';
import FoodImage from '../components/FoodImage.astro';
import MenuItemModal from '../components/menu/MenuItemModal.astro';
import { findItem, formatPrice, priceSegments, isVerifiedImage } from '../lib/menu.js';
import { desiCategories, dealCategory } from '../data/menu-catalog.js';
import { PHONE_TEL, PHONE_DISPLAY, MAPS_DIRECTIONS_URL, MAPS_EMBED_URL, PLUS_CODE } from '../consts.js';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'LocalBusiness'],
  name: 'Smart Cook Dera',
  description:
    'Family restaurant on Sahiwal-Arifwala Road serving fresh Karahi, BBQ and Desi food. Dedicated mosque with Imam on premises. Near Arifwala.',
  url: 'https://smartcookdera.com',
  telephone: '+923056287676',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sahiwal-Arifwala-Bahawalnagar Road',
    addressLocality: 'Arifwala',
    addressRegion: 'Punjab',
    postalCode: '57450',
    addressCountry: 'PK',
  },
  servesCuisine: ['Pakistani', 'BBQ', 'Desi'],
  priceRange: '₨₨',
  hasMap: 'https://plus.codes/82MP+XWF',
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Prayer Facility', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Parking', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Family Seating', value: true },
  ],
  sameAs: ['https://www.facebook.com/smartcookdera'],
});

const muttonKarahi = findItem(desiCategories, 'Mutton', 'Mutton Karahi');
const chickenKarahi = findItem(desiCategories, 'Chicken Karahi', 'Chicken Karahi');
const bbqMix = findItem(desiCategories, 'BBQ', 'BBQ Mix Platter');
const muttonKebab = findItem(desiCategories, 'BBQ', 'Mutton Kebab');
const biryani = findItem(desiCategories, 'Rice', 'Chicken Biryani');
const familyDeal = findItem([dealCategory], 'Deals', 'Deal A');

const seekhKabab = muttonKebab ? { ...muttonKebab, name: 'Seekh Kabab' } : null;
const featured = [muttonKarahi, chickenKarahi, seekhKabab, bbqMix, biryani, familyDeal].filter(Boolean);

// Precompute the display + modal fields for each featured dish so the markup
// stays clean and the modal data-* contract is identical to FoodCard/MenuItem.
const featuredRows = featured.map((item) => {
  const verified = isVerifiedImage(item);
  const fromNote = item.note ? priceSegments(item.note)[0]?.price : '';
  const priceLabel = item.price ? formatPrice(item.price) : fromNote ? `From ${fromNote}` : '';
  return { item, verified, priceLabel };
});

const ticker = [
  'Fresh Karahi', 'Charcoal BBQ', 'Handmade Naan', 'Mutton · Chicken',
  'Halal Kitchen', 'Mosque on Site', 'Family Seating', 'Truck & Bus Parking', 'Doodh Patti Chai',
];

const specs = [
  { k: 'Kitchen', v: '100% Halal' },
  { k: 'On site', v: 'Dedicated Mosque' },
  { k: 'Seating', v: 'Family & Private' },
  { k: 'Parking', v: 'Cars · Buses · Trucks' },
];
---

<BaseLayout
  title="Smart Cook Dera | Restaurant & Mosque on Sahiwal-Arifwala Road | Near Arifwala"
  description="Family restaurant with a dedicated mosque on Sahiwal-Arifwala Road. Fresh Karahi, BBQ, family dining and parking. 8 km from Arifwala. Call now."
  schema={schema}
  headerVariant="utility"
  heroHeader
>
  <!-- ═══════════════ HERO — roadside masthead ═══════════════ -->
  <section class="relative isolate overflow-hidden bg-brand-dark pt-16 md:pt-[4.75rem]" id="hero">
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <img
        src="/images/storefront.webp"
        srcset="/images/storefront-sm.webp 820w, /images/storefront.webp 1485w"
        sizes="100vw"
        alt="Smart Cook Dera family restaurant storefront lit up at night"
        width="1485"
        height="595"
        fetchpriority="high"
        decoding="async"
        data-parallax="0.14"
        class="h-[115%] w-full object-cover object-[center_38%]"
      />
      <!-- Photo-forward: keep the storefront bright. Darken only the bottom
           (behind the headline/CTAs) and the very top (behind the header) so
           text stays legible without muddying the picture. -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/35 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/85 via-transparent to-transparent"></div>
    </div>

    <!-- Masthead dateline -->
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 border-b border-brand-cream/12 px-5 py-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-cream/60 md:px-10 lg:px-16">
      <span class="hero-in">Est. Roadside · Punjab</span>
      <span class="hero-in hidden sm:inline">Sahiwal — Arifwala Rd</span>
      <span class="hero-in" dir="ltr">{PLUS_CODE}</span>
    </div>

    <div class="mx-auto flex min-h-[80vh] max-w-6xl flex-col justify-end px-5 pb-12 pt-24 md:px-10 md:pb-16 lg:px-16">
      <div class="max-w-xl" data-stagger="90">
        <p data-rise class="font-mono text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-brand-accent [text-shadow:0_1px_10px_rgba(10,8,6,0.8)]">
          Family Restaurant · Halal Kitchen
        </p>

        <h1 data-rise class="mt-3 flex flex-wrap items-baseline gap-x-3 font-display text-2xl font-medium leading-tight text-brand-cream [text-shadow:0_2px_18px_rgba(10,8,6,0.75)] md:text-4xl">
          Smart Cook Dera
          <span class="font-urdu-display text-lg font-normal text-brand-accent md:text-2xl" dir="rtl">سمارٹ کک ڈیرہ</span>
        </h1>

        <p data-rise class="mt-3 max-w-lg font-display text-base italic leading-relaxed text-brand-cream/90 [text-shadow:0_1px_16px_rgba(10,8,6,0.8)] md:text-xl">
          Good food, good rest — one memorable stop on the road between Sahiwal and Arifwala.
        </p>

        <div data-rise class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Cta href="/menu" variant="primary">View the Menu</Cta>
          <Cta href={MAPS_DIRECTIONS_URL} variant="ghost" tone="cream">Directions →</Cta>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ TICKER ═══════════════ -->
  <div class="marquee-host relative overflow-hidden border-y border-brand-dark bg-brand-accent py-3 text-brand-cream">
    <div class="marquee" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {ticker.map((t) => (
            <span class="flex items-center font-mono text-[0.72rem] font-semibold uppercase tracking-[0.16em]">
              <span class="px-6">{t}</span>
              <span class="text-brand-cream/50">✦</span>
            </span>
          ))}
        </div>
      ))}
    </div>
    <span class="sr-only">Fresh karahi, charcoal BBQ, handmade naan, halal kitchen, mosque on site, family seating and parking for trucks and buses.</span>
  </div>

  <!-- ═══════════════ STATEMENT + SPECS ═══════════════ -->
  <section class="bg-brand-cream px-5 py-section-lg md:px-10 lg:px-16">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
      <div data-stagger="90">
        <p data-rise class="flex items-center gap-2 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-brand-accent">
          01 — The Dera <span class="font-urdu-display text-sm font-normal tracking-normal text-brand-text-muted" dir="rtl">ڈیرہ</span>
        </p>
        <h2 class="mt-5 font-display text-heading font-medium leading-[1.08] text-brand-text-dark">
          <span class="line-mask"><span>A roadside kitchen where</span></span>
          <span class="line-mask"><span>the karahi is fresh and</span></span>
          <span class="line-mask"><span>the stop is yours to keep.</span></span>
        </h2>
        <p data-rise class="mt-6 max-w-xl text-brand-text-muted">
          Between two towns, on a long highway, Smart Cook Dera is the place to pull over — bone-in mutton karahi from the iron pan, charcoal BBQ, hot naan straight off the tandoor, and a quiet mosque for prayer before you drive on.
        </p>
        <div data-rise class="mt-8">
          <Cta href="/menu" variant="secondary">Explore the Menu</Cta>
        </div>
      </div>

      <!-- Spec sheet -->
      <aside class="md:pt-1" data-stagger="70">
        <div class="mb-4 h-px w-full origin-left bg-brand-text-dark/20" data-route-x></div>
        {specs.map((s) => (
          <div data-rise class="flex items-baseline justify-between gap-4 border-b border-brand-text-dark/12 py-3.5">
            <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-brand-text-muted">{s.k}</span>
            <span class="text-right font-display text-lg font-medium text-brand-text-dark">{s.v}</span>
          </div>
        ))}
        <div data-rise class="mt-8 flex items-end gap-3">
          <span class="font-display text-6xl font-semibold leading-none text-brand-accent" data-count="8" data-count-suffix="">8</span>
          <span class="pb-1 font-mono text-[0.64rem] uppercase leading-tight tracking-[0.16em] text-brand-text-muted">km from<br />Arifwala</span>
        </div>
      </aside>
    </div>
  </section>

  <!-- ═══════════════ SIGNATURE — the index ═══════════════ -->
  <section class="border-t border-brand-text-dark/10 bg-paper-dim px-5 py-section-lg md:px-10 lg:px-16">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p data-rise class="flex items-center gap-2 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-brand-accent">02 — Signature <span class="font-urdu-display text-sm font-normal tracking-normal text-brand-text-muted" dir="rtl">خاص پکوان</span></p>
          <h2 data-rise class="mt-4 font-display text-display font-medium leading-none text-brand-text-dark">From the pan &amp; coals</h2>
        </div>
        <p data-rise class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-brand-text-muted">Tap any dish to order</p>
      </div>

      <ol class="mt-10 border-t border-brand-text-dark/15" data-stagger="60">
        {featuredRows.map(({ item, verified, priceLabel }, i) => (
          <li data-rise class="border-b border-brand-text-dark/15">
            <button
              type="button"
              data-menu-item
              data-id={item.id ?? ''}
              data-name={item.name}
              data-category={item.category}
              data-urdu={item.urdu ?? ''}
              data-price={item.price ?? ''}
              data-note={item.note ?? ''}
              data-description={item.description ?? ''}
              data-image={verified ? item.image : ''}
              data-image-thumb={verified ? (item.imageThumb || item.image) : ''}
              data-image-status={item.imageStatus ?? 'needs-review'}
              data-image-fit={item.imageFit ?? 'cover'}
              data-items={item.items ? item.items.join('||') : ''}
              aria-haspopup="dialog"
              class="group flex w-full items-center gap-4 py-4 text-left transition-colors hover:bg-brand-cream focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent md:gap-6"
            >
              <span class="w-7 shrink-0 font-mono text-sm text-brand-text-muted transition-colors group-hover:text-brand-accent">{String(i + 1).padStart(2, '0')}</span>

              <span class="hidden h-16 w-[5.5rem] shrink-0 overflow-hidden bg-brand-dark md:block" data-media>
                <DishImage
                  src={item.image}
                  thumbSrc={item.imageThumb}
                  alt={item.name}
                  verified={verified}
                  sizes="88px"
                  iconSize={26}
                  fit={item.imageFit ?? 'cover'}
                />
              </span>

              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                  <span class="font-display text-xl font-medium text-brand-text-dark md:text-2xl">{item.name}</span>
                  {item.urdu && <span class="font-urdu-display text-sm text-brand-text-muted" dir="rtl">{item.urdu}</span>}
                </span>
                <span class="mt-0.5 block font-mono text-[0.62rem] uppercase tracking-[0.16em] text-brand-text-muted">{item.category}</span>
                {priceLabel && <span class="mt-1.5 block font-mono text-sm font-bold text-brand-text-dark md:hidden" dir="ltr">{priceLabel}</span>}
              </span>

              <span class="hidden shrink-0 items-center gap-4 md:flex">
                {priceLabel && <span class="font-mono text-sm font-bold tabular-nums text-brand-text-dark" dir="ltr">{priceLabel}</span>}
                <span class="font-mono text-brand-accent transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>

              <span class="shrink-0 self-center font-mono text-brand-accent md:hidden" aria-hidden="true">→</span>
            </button>
          </li>
        ))}
      </ol>

      <div data-rise class="mt-10">
        <Cta href="/menu" variant="primary">See the Full Menu</Cta>
      </div>
    </div>
  </section>

  <!-- ═══════════════ MOSQUE — the quiet register ═══════════════ -->
  <section class="relative overflow-hidden bg-brand-green px-5 py-section-lg text-brand-cream md:px-10 lg:px-16">
    <div class="grain pointer-events-none absolute inset-0 opacity-[0.05] mix-blend-screen" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 md:gap-16">
      <div data-stagger="90">
        <p data-rise class="font-mono text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-brand-accent-light">03 — On the premises · احاطے میں</p>
        <h2 class="mt-5 font-display text-display font-medium leading-[1.05]">
          <span class="line-mask"><span>A mosque for</span></span>
          <span class="line-mask"><span>the traveller.</span></span>
        </h2>
        <p data-rise class="mt-6 max-w-md leading-relaxed text-brand-cream/75">
          Not a prayer corner — a dedicated mosque with a resident Imam leading all five daily prayers. Stop, pray in congregation, and continue your journey with a fresh meal.
        </p>
        <div data-rise class="mt-8">
          <Cta href="/prayer-facility" variant="primary">Prayer Facility →</Cta>
        </div>
      </div>

      <div class="relative aspect-[4/3] overflow-hidden md:aspect-[5/4]" data-media>
        <FoodImage
          imageKey="mosque"
          sizes="(max-width: 768px) 100vw, 560px"
          iconSize={64}
          captionUrdu="مسجد"
          caption="A quiet place to pray"
          captionSub="Open to all travellers"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════ LOCATION — the milestone ═══════════════ -->
  <section class="bg-brand-cream px-5 py-section-lg md:px-10 lg:px-16">
    <div class="mx-auto max-w-6xl">
      <p data-rise class="flex items-center gap-2 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-brand-accent">04 — Find the Dera <span class="font-urdu-display text-sm font-normal tracking-normal text-brand-text-muted" dir="rtl">پتہ</span></p>
      <h2 data-rise class="mt-4 max-w-2xl font-display text-display font-medium leading-[1.05] text-brand-text-dark">
        A milestone between two towns.
      </h2>

      <!-- Route diagram -->
      <div data-rise class="mt-12 flex items-center gap-3 md:gap-5">
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-brand-text-muted">Sahiwal</span>
        <span class="relative flex-1">
          <span class="block h-px w-full origin-left bg-brand-text-dark/30" data-route-x></span>
          <span class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center">
            <span class="h-3 w-3 rounded-full bg-brand-accent ring-4 ring-brand-cream"></span>
          </span>
        </span>
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-brand-text-muted">Arifwala</span>
      </div>
      <p data-rise class="mt-3 text-center font-mono text-[0.62rem] uppercase tracking-[0.2em] text-brand-accent">◆ Smart Cook Dera</p>

      <div class="mt-12 grid gap-10 md:grid-cols-[1fr_1.3fr] md:gap-14">
        <div data-stagger="70">
          <div data-rise class="border-b border-brand-text-dark/12 py-3.5">
            <span class="block font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-text-muted">Address</span>
            <span class="mt-1 block text-brand-text-dark">Sahiwal–Arifwala–Bahawalnagar Road, near Arifwala, Pakpattan District, Punjab</span>
          </div>
          <div data-rise class="border-b border-brand-text-dark/12 py-3.5">
            <span class="block font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-text-muted">Plus Code</span>
            <span class="mt-1 block font-mono text-brand-text-dark" dir="ltr">{PLUS_CODE}</span>
          </div>
          <div data-rise class="border-b border-brand-text-dark/12 py-3.5">
            <span class="block font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-text-muted">Parking</span>
            <span class="mt-1 block text-brand-text-dark">Ample space for cars, buses and trucks</span>
          </div>
          <div data-rise class="mt-8 flex flex-wrap gap-3">
            <Cta href={MAPS_DIRECTIONS_URL} variant="primary">Get Directions</Cta>
            <Cta href={PHONE_TEL} variant="ghost" tone="dark">{PHONE_DISPLAY}</Cta>
          </div>
        </div>

        <div data-media class="overflow-hidden border border-brand-text-dark/15">
          <iframe
            src={MAPS_EMBED_URL}
            width="100%"
            height="300"
            class="block h-[300px] w-full border-0 md:h-full md:min-h-[340px]"
            loading="lazy"
            title="Smart Cook Dera location map"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <MenuItemModal />
</BaseLayout>
