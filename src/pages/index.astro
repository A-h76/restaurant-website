---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import FoodCard from '../components/FoodCard.astro';
import MenuItemModal from '../components/menu/MenuItemModal.astro';
import FoodImage from '../components/FoodImage.astro';
import { findItem } from '../lib/menu.js';
import { desiCategories, dealCategory } from '../data/menu-catalog.js';
import { PHONE_TEL, MAPS_DIRECTIONS_URL, MAPS_EMBED_URL, WHATSAPP_URL } from '../consts.js';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'LocalBusiness'],
  name: 'Smart Cook Dera',
  description:
    'Family restaurant on Sahiwal-Arifwala Road serving fresh Karahi, BBQ and Desi food. Dedicated mosque with Imam on premises. Near Arifwala.',
  url: 'https://smartcookdera.com',
  telephone: '+923056287676',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sahiwal-Arifwala-Bahawalnagar Road',
    addressLocality: 'Arifwala',
    addressRegion: 'Punjab',
    postalCode: '57450',
    addressCountry: 'PK',
  },
  servesCuisine: ['Pakistani', 'BBQ', 'Desi'],
  priceRange: '₨₨',
  hasMap: 'https://plus.codes/82MP+XWF',
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Prayer Facility', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Parking', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Family Seating', value: true },
  ],
  sameAs: ['https://www.facebook.com/smartcookdera'],
});

const pillars = [
  { title: 'Good food', text: 'Karahi, BBQ and biryani, cooked fresh.' },
  { title: 'Clean & welcoming', text: 'A family-friendly stop, kept tidy.' },
  { title: 'Ample parking', text: 'Space for cars, buses and groups.' },
  { title: 'Dedicated mosque', text: 'Pray without leaving the stop.' },
];

const muttonKarahi = findItem(desiCategories, 'Mutton', 'Mutton Karahi');
const chickenKarahi = findItem(desiCategories, 'Chicken Karahi', 'Chicken Karahi');
const bbqMix = findItem(desiCategories, 'BBQ', 'BBQ Mix Platter');
const muttonKebab = findItem(desiCategories, 'BBQ', 'Mutton Kebab');
const biryani = findItem(desiCategories, 'Rice', 'Chicken Biryani');
const familyDeal = findItem([dealCategory], 'Deals', 'Deal A');

const seekhKabab = muttonKebab ? { ...muttonKebab, name: 'Seekh Kabab' } : null;
const featured = [muttonKarahi, chickenKarahi, seekhKabab, bbqMix, biryani, familyDeal].filter(Boolean);
---

<BaseLayout
  title="Smart Cook Dera | Restaurant & Mosque on Sahiwal-Arifwala Road | Near Arifwala"
  description="Family restaurant with a dedicated mosque on Sahiwal-Arifwala Road. Fresh Karahi, BBQ, family dining and parking. 8 km from Arifwala. Call now."
  schema={schema}
  headerVariant="utility"
>
  <section class="relative isolate overflow-hidden" id="hero">
    <img
      src="/images/hero.webp"
      alt="Smart Cook Dera restaurant storefront lit up at night"
      width="787"
      height="477"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-[center_32%]"
    />
    <div class="absolute inset-0 bg-brand-dark/72"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-10 text-center md:px-10 md:py-16 md:text-left lg:px-16 lg:py-20">
      <span class="font-sans text-xs font-semibold uppercase tracking-[0.28em] text-brand-accent">Welcome to</span>
      <p class="mt-2 font-urdu-display text-3xl leading-tight text-brand-accent sm:text-4xl md:text-5xl">سمارٹ کک ڈیرہ</p>
      <h1 class="mt-3 font-display text-[1.85rem] font-bold leading-tight text-brand-cream sm:text-4xl md:text-5xl">
        SMART COOK DERA
      </h1>
      <p class="mt-3 font-display text-xl italic text-brand-cream/90 md:text-2xl">
        Good Food. Good Rest. One Memorable Stop.
      </p>
      <p class="mx-auto mt-4 max-w-xl font-sans text-base leading-relaxed text-brand-cream/80 md:mx-0 md:text-lg">
        Fresh food, family-friendly dining, ample parking, and a dedicated mosque — everything you need for a comfortable stop on the Sahiwal–Arifwala Road.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3 md:justify-start">
        <Cta href={PHONE_TEL}>Call Now</Cta>
        <Cta href={MAPS_DIRECTIONS_URL} variant="secondary">Get Directions</Cta>
        <Cta href="/menu" variant="ghost" tone="accent">View Menu →</Cta>
      </div>
    </div>
  </section>

  <section class="border-b border-brand-accent/15 bg-brand-cream px-4 py-section-sm md:px-10">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-2 lg:grid-cols-4">
      {pillars.map((p) => (
        <article class="rounded-xl bg-white px-3 py-3 text-center shadow-card-sm">
          <h2 class="font-display text-base font-semibold text-brand-text-dark md:text-lg">{p.title}</h2>
          <p class="mt-1 font-sans text-xs leading-relaxed text-brand-text-muted md:text-sm">{p.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-brand-cream px-4 py-section-md md:px-8 lg:px-16">
    <div class="mx-auto max-w-6xl">
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.22em] text-brand-accent">Popular</p>
      <h2 class="mt-1 font-display text-3xl font-semibold text-brand-text-dark md:text-4xl">Your Favourite Food</h2>
      <div class="scrollbar-none mt-5 flex gap-3 overflow-x-auto pb-2">
        {featured.map((item) => (
          <div class="w-[280px] shrink-0 sm:w-[240px]">
            <FoodCard item={item} category={item.category} urdu={item.urdu} note={item.note} />
          </div>
        ))}
      </div>
      <div class="mt-6 text-center">
        <Cta href="/menu" variant="secondary">View Full Menu →</Cta>
      </div>
    </div>
  </section>

  <section class="bg-brand-green px-5 py-section-md lg:px-16">
    <div class="mx-auto grid max-w-6xl items-center gap-8 md:grid-cols-2 md:gap-12">
      <div class="text-center md:text-left">
        <p class="font-sans text-xs font-semibold uppercase tracking-[0.22em] text-brand-accent">On the premises</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-brand-cream md:text-3xl">A dedicated mosque for travellers</h2>
        <p class="mx-auto mt-3 max-w-md font-sans text-sm leading-relaxed text-brand-cream/75 md:mx-0 md:text-base">
          Take a peaceful break, offer your prayer, and continue your journey.
        </p>
        <Cta href="/prayer-facility" variant="secondary" class="mt-5">Learn more →</Cta>
      </div>
      <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-brand-accent/25 md:aspect-[5/4]">
        <FoodImage
          imageKey="mosque"
          sizes="(max-width: 768px) 100vw, 560px"
          iconSize={72}
          caption="A quiet place to pray"
          captionSub="Open to travellers"
        />
      </div>
    </div>
  </section>

  <section class="border-y border-brand-accent/20 bg-brand-cream px-5 py-section-md lg:px-16">
    <div class="mx-auto grid max-w-6xl items-center gap-8 md:grid-cols-2 md:gap-12">
      <div class="text-center md:text-left">
        <p class="font-sans text-xs font-semibold uppercase tracking-widest text-brand-accent">Find us</p>
        <h2 class="mt-1 font-display text-2xl font-semibold text-brand-text-dark md:text-3xl">Sahiwal–Arifwala Road</h2>
        <p class="mx-auto mt-2 max-w-md font-sans text-sm leading-relaxed text-brand-text-muted md:mx-0">
          An easy highway stop with ample parking, conveniently located near Arifwala.
        </p>
        <div class="mt-5 flex flex-col items-center gap-3 sm:flex-row md:justify-start">
          <Cta href={MAPS_DIRECTIONS_URL} variant="primary">Get Directions</Cta>
          <Cta href={PHONE_TEL} variant="ghost" tone="dark">Call for directions</Cta>
        </div>
      </div>
      <div class="overflow-hidden rounded-2xl border border-brand-accent/25">
        <iframe
          src={MAPS_EMBED_URL}
          width="100%"
          height="240"
          style="border:0; display: block;"
          loading="lazy"
          title="Smart Cook Dera location map"
        ></iframe>
      </div>
    </div>
  </section>

  <MenuItemModal />
</BaseLayout>
