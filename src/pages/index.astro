              <p data-pr-eyebrow class="font-mono text-[0.58rem] uppercase tracking-[0.24em] text-brand-accent-light">Next prayer</p>
              <p class="mt-1 font-display text-2xl leading-tight sm:text-3xl">
                <span data-pr-name>Asr</span> <span data-pr-urdu class="font-urdu-display text-lg text-brand-cream/70" dir="rtl"></span>
              </p>
              <p data-pr-when class="mt-0.5 font-mono text-xs text-brand-cream/80"></p>
            </div>
          </div>
          <ol class="mt-5 grid grid-cols-5 border-t border-brand-cream/15 pt-3 text-center">
            {PRAYERS.map((p) => (
              <li data-pr-key={p.key} class="px-0.5 font-mono text-brand-cream/60 aria-[current=true]:text-marigold">
                <span class="block text-[0.52rem] uppercase tracking-[0.14em] sm:text-[0.58rem]">{p.name}</span>
                <span data-pr-time class="mt-1 block text-[0.62rem] font-bold sm:text-xs">—</span>
              </li>
            ))}
          </ol>
          <p class="mt-4 font-mono text-[0.54rem] uppercase leading-relaxed tracking-[0.14em] text-brand-cream/50">
            Calculated for Arifwala (Karachi method, Hanafi Asr) · approximate — jamaat times are set by the Imam
          </p>
        </div>

        <div data-rise class="mt-8">
          <Cta href="/prayer-facility" variant="primary">Prayer Facility →</Cta>
        </div>
      </div>

      <!-- Quiet, geometric cousin of the truck frame -->
      <div data-rise class="truck-frame-quiet">
        <div class="relative aspect-[4/3] overflow-hidden md:aspect-[5/4]" data-media>
          <FoodImage
            imageKey="mosque"
            sizes="(max-width: 768px) 100vw, 560px"
            iconSize={64}
            captionUrdu="مسجد"
            caption="A quiet place to pray"
            captionSub="Open to all travellers"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ KM 0 — ARRIVED: the road, the map ═══════════════ -->
  <section class="bg-brand-cream px-5 py-section-lg md:px-10 lg:px-16" id="find">
    <div class="mx-auto max-w-6xl">
      <div data-rise><Stone km={0} label="Arrived" urdu="پتہ" /></div>
      <h2 data-rise class="mt-4 max-w-2xl font-display text-display font-medium leading-[1.05] text-brand-text-dark">
        A milestone between two towns.
      </h2>

      <!-- The road: the truck drives in and parks at the Dera, 8 km before Arifwala -->
      <div data-rise data-route-wrap class="mt-14" role="img" aria-label="Road from Sahiwal to Arifwala with Smart Cook Dera 8 kilometres before Arifwala">
        <div class="relative pt-9">
          <p class="absolute left-[80%] top-0 -translate-x-1/2 whitespace-nowrap font-mono text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-brand-accent">◆ Smart Cook Dera</p>
          <div class="relative h-4 bg-brand-dark">
            <span class="road-dash absolute inset-x-0 top-1/2 h-[2px] -translate-y-1/2"></span>
            <span class="route-truck absolute left-[80%] top-1/2 -translate-x-1/2 -translate-y-[78%]">
              <svg width="38" height="22" viewBox="0 0 38 22" aria-hidden="true">
                <rect x="1" y="3" width="22" height="13" fill="#C33F26" />
                <rect x="1" y="3" width="22" height="2.4" fill="#D9A441" />
                <path d="M23 7h7l6 5v4H23z" fill="#D9A441" />
                <circle cx="9" cy="17.5" r="3.4" fill="#1B1712" stroke="#E7E1D3" stroke-width="1.2" />
                <circle cx="29" cy="17.5" r="3.4" fill="#1B1712" stroke="#E7E1D3" stroke-width="1.2" />
              </svg>
            </span>
          </div>
          <div class="absolute left-[80%] right-0 top-full mt-1.5 border-t-2 border-brand-accent pt-1 text-center font-mono text-[0.56rem] uppercase tracking-[0.2em] text-brand-accent">8 km</div>
        </div>
        <div class="mt-9 flex justify-between font-mono text-[0.62rem] uppercase tracking-[0.18em] text-brand-text-muted">
          <span>Sahiwal</span>
          <span>Arifwala</span>
        </div>
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-[1fr_1.3fr] md:gap-14">
        <div data-stagger="70">
          <div data-rise class="border-b border-brand-text-dark/12 py-3.5">
            <span class="block font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-text-muted">Address</span>
            <span class="mt-1 block text-brand-text-dark">Sahiwal–Arifwala–Bahawalnagar Road, near Arifwala, Pakpattan District, Punjab</span>
          </div>
          <div data-rise class="border-b border-brand-text-dark/12 py-3.5">
            <span class="block font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-text-muted">Plus Code</span>
            <span class="mt-1 block font-mono text-brand-text-dark" dir="ltr">{PLUS_CODE}</span>
          </div>
          <div data-rise class="border-b border-brand-text-dark/12 py-3.5">
            <span class="block font-mono text-[0.6rem] uppercase tracking-[0.2em] text-brand-text-muted">Parking</span>
            <span class="mt-1 block text-brand-text-dark">Ample space for cars, buses and trucks</span>
          </div>
          <div data-rise class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <Cta href={MAPS_DIRECTIONS_URL} variant="primary">Get Directions</Cta>
            <Cta href={PHONE_TEL} variant="ghost" tone="dark">{PHONE_DISPLAY}</Cta>
          </div>
        </div>

        <div class="truck-frame">
          <div data-media class="overflow-hidden">
            <iframe
              src={MAPS_EMBED_URL}
              width="100%"
              height="300"
              class="block h-[300px] w-full border-0 md:h-full md:min-h-[340px]"
