---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Stone from '../components/Stone.astro';
import Ticker from '../components/Ticker.astro';
import RouteRoad from '../components/RouteRoad.astro';
import DishImage from '../components/menu/DishImage.astro';
import FoodImage from '../components/FoodImage.astro';
import MenuItemModal from '../components/menu/MenuItemModal.astro';
import { findItem, formatPrice, priceSegments, isVerifiedImage } from '../lib/menu.js';
import { desiCategories, dealCategory } from '../data/menu-catalog.js';
import { PRAYERS } from '../lib/prayer.js';
import { PHONE_TEL, PHONE_DISPLAY, WHATSAPP_URL, WHATSAPP_DISPLAY, MAPS_DIRECTIONS_URL, MAPS_EMBED_URL, PLUS_CODE } from '../consts.js';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'LocalBusiness'],
  name: 'Smart Cook Dera',
  description:
    'Family restaurant on Sahiwal-Arifwala Road serving fresh Karahi, BBQ and Desi food. Dedicated mosque with Imam on premises. Near Arifwala.',
  url: 'https://smartcookdera.com',
  telephone: '+923056287676',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sahiwal-Arifwala-Bahawalnagar Road',
    addressLocality: 'Arifwala',
    addressRegion: 'Punjab',
    postalCode: '57450',
    addressCountry: 'PK',
  },
  servesCuisine: ['Pakistani', 'BBQ', 'Desi'],
  priceRange: '₨₨',
  hasMap: 'https://plus.codes/82MP+XWF',
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Prayer Facility', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Parking', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Family Seating', value: true },
  ],
  sameAs: ['https://www.facebook.com/smartcookdera'],
});

// ── Signature dishes (modal data contract identical to FoodCard/MenuItem) ──
const muttonKarahi = findItem(desiCategories, 'Mutton', 'Mutton Karahi');
const chickenKarahi = findItem(desiCategories, 'Chicken Karahi', 'Chicken Karahi');
const bbqMix = findItem(desiCategories, 'BBQ', 'BBQ Mix Platter');
const muttonKebab = findItem(desiCategories, 'BBQ', 'Mutton Kebab');
const biryani = findItem(desiCategories, 'Rice', 'Chicken Biryani');
const familyDeal = findItem([dealCategory], 'Deals', 'Deal A');

const seekhKabab = muttonKebab ? { ...muttonKebab, name: 'Seekh Kabab' } : null;
const featured = [muttonKarahi, chickenKarahi, seekhKabab, bbqMix, biryani, familyDeal].filter(Boolean);

// Ticket lines show ONE price: "from ₨X" when a dish has sizes (full list lives in the modal).
const featuredRows = featured.map((item) => {
  const verified = isVerifiedImage(item);
  const segs = priceSegments(item.price);
  const fromNote = item.note ? priceSegments(item.note)[0]?.price : '';
  const priceLabel = segs.length > 1 ? `from ${segs[0].price}` : item.price ? formatPrice(item.price) : fromNote ? `from ${fromNote}` : '';
  return { item, verified, priceLabel };
});

const heroBand = ['Mosque on site', 'Family hall', 'Truck & bus parking', 'Charcoal BBQ'];
const menuBand = ['Fresh karahi', 'Charcoal BBQ', 'Tandoori naan', 'Mutton · Chicken · Beef', 'Doodh patti chai', 'Fast food & Chinese'];

const specs = [
  { k: 'Kitchen', v: '100% Halal' },
  { k: 'On site', v: 'Dedicated mosque' },
  { k: 'Seating', v: 'Family & private' },
  { k: 'Parking', v: 'Cars · Buses · Trucks' },
];

// Three crops of the one storefront photo, taped up as polaroids.
const polaroids = [
  { title: 'Open kitchen', text: 'Karahi, BBQ and the tandoor, all in view.', pos: 'object-[6%_50%]', rot: '-rotate-2', sh: '[--sh:var(--color-ink)]', tape: 'bg-marigold/80', head: 'text-brand-accent' },
  { title: 'Family hall', text: 'A lit arch to walk through. Private seating inside.', pos: 'object-[52%_50%]', rot: 'rotate-1', sh: '[--sh:var(--color-vermilion)]', tape: 'bg-brand-mid/80', head: 'text-brand-mid' },
  { title: 'Room to park', text: 'Cars, buses and trucks, straight off the road.', pos: 'object-[96%_50%]', rot: '-rotate-1 md:rotate-2', sh: '[--sh:var(--color-olive)]', tape: 'bg-brand-accent/70', head: 'text-brand-text-dark' },
];

// ── The journey: five km stones, 8 → 0. Rail, eyebrows and dial all read from this. ──
const stops = [
  { id: 'hero', km: 8, label: 'Approach' },
  { id: 'dera', km: 6, label: 'The Dera' },
  { id: 'signature', km: 4, label: 'Signature' },
  { id: 'prayer', km: 2, label: 'Prayer' },
  { id: 'find', km: 0, label: 'Find us' },
];
const stopTop = ['top-0', 'top-1/4', 'top-1/2', 'top-3/4', 'top-full'];

// ── Sunburst gauge geometry (viewBox 400): 24 wedges, every other one marigold. ──
const pt = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return `${(200 + r * Math.sin(a)).toFixed(2)} ${(200 - r * Math.cos(a)).toFixed(2)}`;
};
const wedges = Array.from({ length: 24 }, (_, i) => {
  const a0 = i * 15 + 1.2;
  const a1 = i * 15 + 13.8;
  const r1 = 120;
  const r2 = 184;
  return `M${pt(a0, r1)}L${pt(a0, r2)}A${r2} ${r2} 0 0 1 ${pt(a1, r2)}L${pt(a1, r1)}A${r1} ${r1} 0 0 0 ${pt(a0, r1)}Z`;
});
---

<BaseLayout
  title="Smart Cook Dera | Restaurant & Mosque on Sahiwal-Arifwala Road | Near Arifwala"
  description="Family restaurant with a dedicated mosque on Sahiwal-Arifwala Road. Fresh Karahi, BBQ, family dining and parking. 8 km from Arifwala. Call now."
  schema={schema}
>
  <!-- ═══ KM RAIL (desktop): the page is the 8 km approach; the marker travels it ═══ -->
  <nav id="km-rail" aria-label="Page sections" class="fixed left-3 top-1/2 z-30 hidden -translate-y-[55%] lg:block xl:left-5">
    <div class="relative h-[50vh] w-10">
      <span class="absolute inset-y-0 left-1/2 -translate-x-1/2 border-l-[3px] border-dashed border-brand-accent/70" aria-hidden="true"></span>
      {stops.map((s, i) => (
        <a
          href={`#${s.id}`}
          data-km-stop={s.id}
          title={s.label}
          aria-label={`${s.label}, ${s.km} kilometres to go`}
          class={`stone absolute left-1/2 -translate-x-1/2 -translate-y-1/2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent ${stopTop[i]}`}
        >
          <small>km</small><b>{s.km}</b>
        </a>
      ))}
      <span data-km-marker class="pointer-events-none absolute left-[calc(50%+1.6rem)] top-0 -translate-y-1/2 border-y-[7px] border-r-[10px] border-y-transparent border-r-brand-accent" aria-hidden="true"></span>
    </div>
    <p class="mt-6 w-10 rounded-md border-2 border-brand-text-dark bg-paper-bright py-1.5 text-center font-mono text-brand-text-dark shadow-card-sm" aria-hidden="true">
      <b data-km-readout class="block text-xs">8.0</b>
      <span class="text-[0.46rem] uppercase tracking-[0.08em]">km left</span>
    </p>
  </nav>

  <!-- KM PILL (mobile/tablet): same journey, one small chip -->
  <div id="km-pill" class="fixed left-3 z-30 bottom-[calc(5.625rem+env(safe-area-inset-bottom))] md:bottom-6 lg:hidden" aria-hidden="true">
    <div class="relative flex min-h-12 items-center gap-2 overflow-hidden rounded-full border-2 border-brand-text-dark bg-paper-bright py-1 pl-1.5 pr-3.5 text-[0.7rem] font-extrabold uppercase tracking-[0.1em] text-brand-text-dark shadow-soft">
      <span class="stone !min-w-0 !px-1.5"><small>km</small><b data-km-now>8</b></span>
      <span data-km-label>Approach</span>
    </div>
  </div>

  <!-- ═══════════════ KM 8 — HERO: the sticker, the title, the sunburst gauge ═══════════════ -->
  <section class="relative overflow-hidden bg-brand-cream" id="hero">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-14 pt-9 md:px-10 md:pt-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-10 lg:px-16 lg:pb-16">
      <div data-stagger="100">
        <div class="hero-in"><span class="sticker">★ Family Restaurant ★</span></div>

        <h1 class="mt-5 font-display text-[clamp(3.6rem,13.5vw,8.5rem)] font-black leading-[0.9] text-brand-text-dark text-pop">
          <span class="line-mask"><span>Smart</span></span>
          <span class="line-mask"><span>Cook</span></span>
          <span class="line-mask"><span class="text-brand-accent text-pop-ink">Dera</span></span>
        </h1>
        <p class="sr-only">سمارٹ کک ڈیرہ</p>

        <p data-rise class="mt-6 max-w-lg text-balance font-display text-2xl font-black italic leading-tight text-brand-mid md:text-[1.9rem]">
          Good food, good rest, one stop on the road.
        </p>
        <p data-rise class="mt-4 max-w-md text-base leading-relaxed text-brand-text-dark/85 md:text-lg">
          Iron-pan karahi, coal-fired tikka and naan straight off the tandoor. A proper desi stop between Sahiwal and Arifwala, with family seating and a mosque on site.
        </p>

        <div data-rise class="mt-8 flex flex-wrap items-center gap-4">
          <Cta href="/menu" variant="primary">See the menu</Cta>
          <Cta href={MAPS_DIRECTIONS_URL} variant="secondary">Get directions →</Cta>
        </div>
      </div>

      <!-- Sunburst gauge: spins as you "drive" and counts the km left -->
      <div class="hero-in relative mx-auto w-full max-w-[24rem] lg:max-w-[28rem]">
        <svg viewBox="0 0 400 400" class="h-auto w-full overflow-visible" role="img" aria-label="Gauge showing the kilometres left to the Dera, counting down as you scroll">
          <circle cx="200" cy="200" r="190" fill="#3B2217" />
          <circle cx="194" cy="194" r="190" fill="#FFFBF0" stroke="#3B2217" stroke-width="5" />
          <g data-burst transform="rotate(0 200 200)">
            {wedges.map((d, i) => (
              <path d={d} fill={i % 2 ? '#E9A61A' : '#F4E8D0'} stroke="#3B2217" stroke-width="2.5" stroke-linejoin="round" />
            ))}
          </g>
          <circle cx="207" cy="207" r="112" fill="#3B2217" />
          <circle cx="200" cy="200" r="112" fill="#FFFBF0" stroke="#3B2217" stroke-width="5" />
          <text x="200" y="138" text-anchor="middle" font-size="14" letter-spacing="3" class="fill-brand-text-dark font-sans" font-weight="800">KM TO THE DERA</text>
          <text data-dial-readout x="205" y="238" text-anchor="middle" font-size="104" font-weight="900" class="fill-brand-text-dark font-display">8</text>
          <text data-dial-readout x="200" y="233" text-anchor="middle" font-size="104" font-weight="900" class="fill-brand-accent font-display">8</text>
          <text x="200" y="270" text-anchor="middle" font-size="18" class="fill-brand-mid font-urdu-display">عارف والا سے پہلے</text>
          <rect x="140" y="286" width="120" height="26" rx="13" fill="#FFFBF0" stroke="#3B2217" stroke-width="2.5" />
          <text x="200" y="304" text-anchor="middle" font-size="12.5" letter-spacing="2" class="fill-brand-text-dark font-sans" font-weight="800">{PLUS_CODE}</text>
        </svg>
        <!-- 100% Halal badge -->
        <div class="absolute -right-1 -top-2 flex h-24 w-24 rotate-[14deg] flex-col items-center justify-center rounded-full border-2 border-brand-text-dark bg-brand-accent text-brand-cream shadow-soft md:h-28 md:w-28" aria-hidden="true">
          <span class="font-display text-2xl font-black leading-none md:text-3xl">100%</span>
          <span class="mt-0.5 text-[0.6rem] font-extrabold uppercase tracking-[0.2em] md:text-[0.68rem]">Halal</span>
        </div>
      </div>
    </div>
  </section>

  <Ticker items={heroBand} label="Mosque on site, family hall, truck and bus parking, charcoal BBQ." />

  <!-- ═══════════════ KM 6 — THE STOP: three taped polaroids ═══════════════ -->
  <section class="bg-paper-dim px-5 py-section-md md:px-10 lg:px-16" id="dera">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
        <div data-stagger="90">
          <div data-rise><Stone km={6} label="The stop" /></div>
          <h2 data-rise class="mt-5 font-display text-display font-black leading-[0.98] text-brand-text-dark text-pop-white">
            Lit up after dark,<br /><span class="text-brand-accent">open for you.</span>
          </h2>
        </div>
        <p data-rise class="font-urdu-display text-2xl leading-[1.8] text-brand-mid md:text-4xl" dir="rtl">رکیے، کھائیے، آرام کیجیے</p>
      </div>

      <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-8" data-stagger="120">
        {polaroids.map((p) => (
          <figure data-rise class={`polaroid relative px-3 pb-5 pt-3 ${p.rot} ${p.sh}`}>
            <span class={`absolute -top-3 left-1/2 h-6 w-24 -translate-x-1/2 -rotate-3 ${p.tape}`} aria-hidden="true"></span>
            <div class="aspect-square overflow-hidden border-2 border-brand-text-dark">
              <img
                src="/images/storefront.webp"
                alt={`${p.title} at Smart Cook Dera`}
                width="1485"
                height="595"
                loading="lazy"
                decoding="async"
                sizes="(min-width: 768px) 30vw, 90vw"
                class={`h-full w-full origin-bottom scale-[1.28] object-cover ${p.pos}`}
              />
            </div>
            <figcaption class="mt-4">
              <p class={`font-display text-2xl font-black leading-tight ${p.head}`}>{p.title}</p>
              <p class="mt-1 text-sm leading-snug text-brand-text-dark/85">{p.text}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Ticker items={menuBand} tone="red" label="Fresh karahi, charcoal BBQ, tandoori naan, mutton, chicken and beef, doodh patti chai, fast food and Chinese." />

  <!-- ═══════════════ THE DERA: statement + ticket ═══════════════ -->
  <section class="bg-brand-cream px-5 py-section-lg md:px-10 lg:px-16">
    <div class="mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <div data-stagger="90">
        <h2 class="font-display text-heading font-black leading-[1.05] text-brand-text-dark text-pop">
          <span class="line-mask"><span>A roadside kitchen</span></span>
          <span class="line-mask"><span>where the karahi is</span></span>
          <span class="line-mask"><span>fresh and the stop is</span></span>
          <span class="line-mask"><span class="text-brand-accent text-pop-ink">yours to keep.</span></span>
        </h2>
        <p data-rise class="mt-6 max-w-xl text-base leading-relaxed text-brand-text-dark/85 md:text-lg">
          Between two towns on a long highway, this is the place to pull over: bone-in mutton karahi from the iron pan, charcoal BBQ, hot naan off the tandoor, and a quiet mosque for prayer before you drive on.
        </p>
        <div data-rise class="mt-8 flex flex-wrap items-center gap-4">
          <Cta href="/menu" variant="primary">Explore the menu</Cta>
          <Cta href={WHATSAPP_URL} variant="secondary" target="_blank" rel="noopener noreferrer">WhatsApp <span dir="ltr">{WHATSAPP_DISPLAY}</span></Cta>
        </div>
      </div>

      <!-- Admit-all ticket -->
      <aside data-rise class="ticket w-full max-w-sm rotate-2 overflow-hidden md:justify-self-end" aria-label="At a glance">
        <div class="flex items-center justify-between gap-3 border-b-2 border-brand-text-dark bg-brand-mid px-5 py-3 text-brand-cream">
          <span class="font-display text-2xl font-black italic">Admit all</span>
          <span class="text-[0.68rem] font-extrabold uppercase tracking-[0.2em]">Smart Cook Dera</span>
        </div>
        <div class="px-5">
          {specs.map((s) => (
            <div class="flex items-baseline justify-between gap-4 border-b-2 border-dotted border-brand-text-dark/40 py-3.5 last:border-b-0">
              <span class="text-[0.68rem] font-extrabold uppercase tracking-[0.2em] text-brand-text-muted">{s.k}</span>
              <span class="text-right font-display text-lg font-black text-brand-text-dark">{s.v}</span>
            </div>
          ))}
        </div>
        <div class="border-t-2 border-dashed border-brand-text-dark px-5 pb-5 pt-4">
          <div class="barcode" aria-hidden="true"></div>
          <p class="mt-2 text-center text-[0.7rem] font-extrabold tracking-[0.3em] text-brand-text-dark" dir="ltr">No. {PLUS_CODE}</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ═══════════════ KM 4 — SIGNATURE: the dera parchi, heated by the tandoor ═══════════════ -->
  <section class="heat-section border-y-2 border-brand-text-dark px-5 py-section-lg md:px-10 lg:px-16" id="signature" data-heat>
    <div class="mx-auto max-w-6xl">
      <div data-rise><Stone km={4} label="Signature" urdu="خاص پکوان" /></div>
      <h2 data-rise class="mt-5 font-display text-display font-black leading-none text-brand-text-dark text-pop-white">From the pan &amp; coals</h2>

      <div class="mt-14 grid items-start gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
        <!-- The parchi -->
        <div data-rise class="ticket overflow-hidden pb-6 pt-7 [--sh:var(--color-olive)]" id="parchi">
          <div class="flex items-start justify-between gap-4 px-5 md:px-8">
            <div>
              <p class="font-display text-3xl font-black uppercase leading-none tracking-wide text-brand-text-dark md:text-4xl">Dera Parchi</p>
              <p class="mt-2 text-[0.7rem] font-extrabold uppercase tracking-[0.18em] text-brand-text-muted">Today’s picks · tap a line to order</p>
            </div>
            <span class="mt-1 -rotate-12 shrink-0 select-none rounded-full border-[3px] border-brand-accent px-2 py-3 text-center text-[0.52rem] font-black uppercase leading-tight tracking-[0.12em] text-brand-accent md:text-[0.58rem]" aria-hidden="true">
              Fresh<br />Halal<br />Daily
            </span>
          </div>

          <ol class="mt-6 border-t-2 border-dashed border-brand-text-dark" data-stagger="60">
            {featuredRows.map(({ item, verified, priceLabel }, i) => (
              <li data-rise class="border-b-2 border-dashed border-brand-text-dark/25">
                <button
                  type="button"
                  data-menu-item
                  data-line
                  data-id={item.id ?? ''}
                  data-name={item.name}
                  data-category={item.category}
                  data-urdu={item.urdu ?? ''}
                  data-price={item.price ?? ''}
                  data-note={item.note ?? ''}
                  data-description={item.description ?? ''}
                  data-image={verified ? item.image : ''}
                  data-image-thumb={verified ? (item.imageThumb || item.image) : ''}
                  data-image-status={item.imageStatus ?? 'needs-review'}
                  data-image-fit={item.imageFit ?? 'cover'}
                  data-items={item.items ? item.items.join('||') : ''}
                  aria-haspopup="dialog"
                  class="group flex w-full items-center gap-3 px-5 py-3.5 text-left transition-colors hover:bg-paper-dim focus-visible:bg-paper-dim focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-accent md:gap-4 md:px-8"
                >
                  <span class="hidden w-6 shrink-0 font-mono text-sm text-brand-text-muted transition-colors group-hover:text-brand-accent sm:block">{String(i + 1).padStart(2, '0')}</span>

                  <!-- Mobile: every dish keeps its photo as a small polaroid -->
                  <span class="block h-14 w-[4.5rem] shrink-0 -rotate-2 border-2 border-brand-text-dark bg-white p-0.5 shadow-card-sm lg:hidden">
                    <span class="block h-full w-full overflow-hidden bg-brand-dark">
                      <DishImage src={item.image} thumbSrc={item.imageThumb} alt="" verified={verified} sizes="72px" iconSize={20} fit={item.imageFit ?? 'cover'} />
                    </span>
                  </span>

                  <span class="min-w-0 flex-1 sm:flex-none">
                    <span class="flex flex-wrap items-baseline gap-x-3">
                      <span class="font-display text-lg font-black leading-tight text-brand-text-dark md:text-2xl">{item.name}</span>
                      {item.urdu && <span class="font-urdu-display text-sm text-brand-text-muted" dir="rtl">{item.urdu}</span>}
                    </span>
                    <span class="mt-0.5 block text-[0.62rem] font-extrabold uppercase tracking-[0.16em] text-brand-text-muted">{item.category}</span>
                  </span>

                  <span class="leader mb-2 hidden min-w-6 flex-1 self-end sm:block" aria-hidden="true"></span>

                  {priceLabel && <span class="shrink-0 text-right text-[0.85rem] font-extrabold tabular-nums text-brand-text-dark md:text-base" dir="ltr">{priceLabel}</span>}
                  <span class="hidden shrink-0 font-black text-brand-accent transition-transform duration-200 group-hover:translate-x-1 md:inline" aria-hidden="true">→</span>
                </button>
              </li>
            ))}
          </ol>

          <div class="flex flex-wrap items-center justify-between gap-4 px-5 pt-5 md:px-8">
            <p class="text-[0.7rem] font-extrabold uppercase tracking-[0.16em] text-brand-text-muted">Cooked to order · Mutton &amp; Chicken</p>
            <Cta href="/menu" variant="primary">Full menu</Cta>
          </div>
        </div>

        <!-- Desktop stage: the dish lifts off the parchi as a taped polaroid -->
        <div class="hidden lg:sticky lg:top-32 lg:block" aria-hidden="true">
          <div class="mx-auto grid w-full max-w-sm">
            {featuredRows.map(({ item, verified, priceLabel }, i) => (
              <figure data-stage data-active={i === 0 ? '' : undefined} class={`polaroid relative cursor-pointer px-3 pb-16 pt-3 [grid-area:1/1] ${i % 2 ? '[--sh:var(--color-vermilion)]' : '[--sh:var(--color-ink)]'}`}>
                <span class="absolute -top-3 left-1/2 h-6 w-24 -translate-x-1/2 -rotate-3 bg-marigold/80"></span>
                <div class="aspect-[4/3] overflow-hidden border-2 border-brand-text-dark bg-brand-dark">
                  <DishImage src={item.image} thumbSrc={item.imageThumb} alt="" verified={verified} sizes="384px" iconSize={40} fit={item.imageFit ?? 'cover'} />
                </div>
                <figcaption class="absolute inset-x-4 bottom-4 flex items-baseline justify-between gap-3">
                  <span class="font-display text-xl font-black italic leading-tight text-brand-text-dark">{item.name}</span>
                  {priceLabel && <span class="shrink-0 text-sm font-extrabold text-brand-accent" dir="ltr">{priceLabel}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ KM 2 — PRAYER: the quiet register, aware of the hour ═══════════════ -->
  <div class="stripes" aria-hidden="true"></div>
  <section class="relative overflow-hidden bg-brand-green px-5 py-section-lg text-brand-cream md:px-10 lg:px-16" id="prayer" data-prayer-section>
    <div class="bg-geo pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2 md:gap-16">
      <div data-stagger="90">
        <div data-rise><Stone km={2} label="On the premises" urdu="احاطے میں" tone="dark" /></div>
        <h2 class="mt-5 font-display text-display font-black leading-[1.02] text-brand-cream text-pop-red">
          <span class="line-mask"><span>A mosque for</span></span>
          <span class="line-mask"><span>the traveller.</span></span>
        </h2>
        <p data-rise class="mt-6 max-w-md text-base leading-relaxed text-brand-cream/85 md:text-lg">
          Not a prayer corner — a dedicated mosque with a resident Imam leading all five daily prayers. Stop, pray in congregation, and continue your journey with a fresh meal.
        </p>

        <!-- Live prayer panel: filled in by JS, hidden without it -->
        <div data-prayer-panel hidden class="mt-8 max-w-md rounded-2xl border-2 border-brand-cream/60 bg-brand-dark/30 p-5">
          <div class="flex items-center gap-4">
            <svg class="crescent-glow h-12 w-12 shrink-0 text-marigold" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M32 6a18 18 0 1 0 10 32A14 14 0 0 1 32 6z" fill="currentColor" />
              <circle cx="38" cy="14" r="1.6" fill="currentColor" />
            </svg>
            <div aria-live="polite">
              <p data-pr-eyebrow class="text-[0.66rem] font-extrabold uppercase tracking-[0.22em] text-brand-accent-light">Next prayer</p>
              <p class="mt-1 font-display text-3xl font-black leading-tight">
                <span data-pr-name>Asr</span> <span data-pr-urdu class="font-urdu-display text-lg font-normal text-brand-cream/80" dir="rtl"></span>
              </p>
              <p data-pr-when class="mt-0.5 text-sm font-semibold text-brand-cream/90"></p>
            </div>
          </div>
          <ol class="mt-5 grid grid-cols-5 border-t-2 border-dashed border-brand-cream/30 pt-3 text-center">
            {PRAYERS.map((p) => (
              <li data-pr-key={p.key} class="px-0.5 text-brand-cream/70 aria-[current=true]:text-marigold">
                <span class="block text-[0.56rem] font-extrabold uppercase tracking-[0.1em] sm:text-[0.64rem]">{p.name}</span>
                <span data-pr-time class="mt-1 block text-[0.64rem] font-extrabold sm:text-xs">—</span>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-[0.6rem] font-bold uppercase leading-relaxed tracking-[0.12em] text-brand-cream/65">
            Calculated for Arifwala (Karachi method, Hanafi Asr) · approximate — jamaat times are set by the Imam
          </p>
        </div>

        <div data-rise class="mt-8">
          <Cta href="/prayer-facility" variant="primary">Prayer facility →</Cta>
        </div>
      </div>

      <!-- Quiet, geometric cousin of the truck frame -->
      <div data-rise class="truck-frame-quiet">
        <div class="relative aspect-[4/3] overflow-hidden md:aspect-[5/4]" data-media>
          <FoodImage
            imageKey="mosque"
            sizes="(max-width: 768px) 100vw, 560px"
            iconSize={64}
            captionUrdu="مسجد"
            caption="A quiet place to pray"
            captionSub="Open to all travellers"
          />
        </div>
      </div>
    </div>
  </section>
  <div class="stripes" aria-hidden="true"></div>

  <!-- ═══════════════ KM 0 — ARRIVED: the road, the map ═══════════════ -->
  <section class="bg-brand-cream px-5 py-section-lg md:px-10 lg:px-16" id="find">
    <div class="mx-auto max-w-6xl">
      <div data-rise><Stone km={0} label="Arrived" urdu="پتہ" /></div>
      <h2 data-rise class="mt-5 max-w-3xl font-display text-display font-black leading-[1.02] text-brand-text-dark text-pop">
        A milestone between two towns.
      </h2>

      <RouteRoad class="mt-14" />

      <div class="mt-12 grid gap-10 md:grid-cols-[1fr_1.3fr] md:gap-14">
        <div data-stagger="70">
          <div data-rise class="border-b-2 border-dashed border-brand-text-dark/30 py-3.5">
            <span class="block text-[0.66rem] font-extrabold uppercase tracking-[0.2em] text-brand-text-muted">Address</span>
            <span class="mt-1 block font-semibold text-brand-text-dark">Sahiwal–Arifwala–Bahawalnagar Road, near Arifwala, Pakpattan District, Punjab</span>
          </div>
          <div data-rise class="border-b-2 border-dashed border-brand-text-dark/30 py-3.5">
            <span class="block text-[0.66rem] font-extrabold uppercase tracking-[0.2em] text-brand-text-muted">Plus Code</span>
            <span class="mt-1 block font-display text-xl font-black text-brand-text-dark" dir="ltr">{PLUS_CODE}</span>
          </div>
          <div data-rise class="border-b-2 border-dashed border-brand-text-dark/30 py-3.5">
            <span class="block text-[0.66rem] font-extrabold uppercase tracking-[0.2em] text-brand-text-muted">Parking</span>
            <span class="mt-1 block font-semibold text-brand-text-dark">Ample space for cars, buses and trucks</span>
          </div>
          <div data-rise class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <Cta href={MAPS_DIRECTIONS_URL} variant="primary">Get directions</Cta>
            <Cta href={PHONE_TEL} variant="ghost" tone="dark"><span dir="ltr">{PHONE_DISPLAY}</span></Cta>
          </div>
        </div>

        <div class="truck-frame">
          <div data-media class="overflow-hidden">
            <iframe
              src={MAPS_EMBED_URL}
              width="100%"
              height="300"
              class="block h-[300px] w-full border-0 md:h-full md:min-h-[340px]"
              loading="lazy"
              title="Smart Cook Dera location map"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <MenuItemModal />

  <script>
    import { prayerState, fmtClock, PRAYERS } from '../lib/prayer.js';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = (sel: string, root: ParentNode = document) => root.querySelector<HTMLElement>(sel);
    const $$ = (sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<HTMLElement>(sel));

    // ── THE JOURNEY: one scroll value (km left, 8 → 0) drives rail, pill and gauge ──
    const TOTAL_KM = 8;
    const railStops = $$('#km-rail [data-km-stop]');
    const sections = railStops.map((a) => document.getElementById(a.dataset.kmStop!)!);
    const n = sections.length;
    const marker = $('[data-km-marker]');
    const railReadout = $('[data-km-readout]');
    const pillNow = $('[data-km-now]');
    const pillLabel = $('[data-km-label]');
    const burst = document.querySelector('[data-burst]');
    const dialReadouts = Array.from(document.querySelectorAll('[data-dial-readout]'));
    const heatEl = $('[data-heat]');
    const labels = ['Approach', 'The Dera', 'Signature', 'Prayer', 'Arrived'];

    let tops: number[] = [];
    let intro = reduce ? 1 : 0; // the gauge spins up and counts from 0 on load
    let active = -1;

    const measure = () => {
      tops = sections.map((s) => s.getBoundingClientRect().top + window.scrollY);
    };

    const render = () => {
      const y = window.scrollY;
      const vh = window.innerHeight;
      // Look-ahead line: pinned to the top at scroll 0, settles to 45% down the viewport.
      const ref = y + Math.min(y, vh * 0.45);
      const atBottom = y + vh >= document.documentElement.scrollHeight - 2;

      let u: number;
      if (atBottom || ref >= tops[n - 1]) u = n - 1;
      else if (ref <= tops[0]) u = 0;
      else {
        let k = 0;
        while (tops[k + 1] <= ref) k++;
        u = k + (ref - tops[k]) / (tops[k + 1] - tops[k]);
      }

      const progress = u / (n - 1);
      const km = TOTAL_KM * (1 - progress);
      const arrived = km < 0.05;
      const now = Math.round(u);

      if (marker) marker.style.top = progress * 100 + '%';
      if (railReadout) railReadout.textContent = arrived ? 'Here' : km.toFixed(1);
      if (pillNow) pillNow.textContent = String(Math.round(km));
      if (now !== active) {
        active = now;
        railStops.forEach((a, i) => a.setAttribute('aria-current', String(i === now)));
        if (pillLabel) pillLabel.textContent = labels[now];
      }

      // Gauge: the sunburst turns as you "drive"; the big number is the same km.
      const kmDial = km * intro;
      burst?.setAttribute('transform', `rotate(${(progress * 150 + (1 - intro) * 120).toFixed(2)} 200 200)`);
      dialReadouts.forEach((t) => (t.textContent = String(Math.round(kmDial))));

      // Tandoor heat peaks when the signature section is centred in view.
      if (heatEl && !reduce) {
        const r = heatEl.getBoundingClientRect();
        const heat = Math.max(0, 1 - Math.abs(r.top + r.height / 2 - vh / 2) / (vh * 0.85));
        heatEl.style.setProperty('--heat', heat.toFixed(3));
      }
    };

    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        render();
      });
    };

    measure();
    render();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => { measure(); schedule(); }, { passive: true });
    new ResizeObserver(() => { measure(); schedule(); }).observe(document.body); // images/fonts shift layout

    if (!reduce) {
      const t0 = performance.now() + 250;
      const rev = (t: number) => {
        const p = Math.min(1, Math.max(0, (t - t0) / 1300));
        intro = 1 - Math.pow(1 - p, 3);
        render();
        if (p < 1) requestAnimationFrame(rev);
      };
      requestAnimationFrame(rev);
    }

    // ── PARCHI → POLAROID: hovering/focusing a line lifts that dish onto the stage ──
    const lines = $$('[data-line]');
    const stages = $$('[data-stage]');
    const setStage = (i: number) => stages.forEach((s, j) => s.toggleAttribute('data-active', i === j));
    lines.forEach((l, i) => {
      l.addEventListener('mouseenter', () => setStage(i));
      l.addEventListener('focus', () => setStage(i));
    });
    stages.forEach((s, i) => s.addEventListener('click', () => lines[i]?.click()));

    // ── PRAYER: next prayer + countdown, in Pakistan time whatever the device clock says ──
    const panel = $('[data-prayer-panel]');
    const section = $('[data-prayer-section]');
    const humanLeft = (m: number) => {
      const t = Math.ceil(m);
      return t >= 60 ? `${Math.floor(t / 60)}h ${t % 60}m` : `${t} min`;
    };
    const paintPrayer = () => {
      if (!panel) return;
      const { times, next, minsLeft, active: live } = prayerState();
      $('[data-pr-name]', panel)!.textContent = live ? live.name : next.name;
      $('[data-pr-urdu]', panel)!.textContent = live ? live.urdu : next.urdu;
      $('[data-pr-eyebrow]', panel)!.textContent = live ? 'Time for prayer' : 'Next prayer';
      $('[data-pr-when]', panel)!.textContent = live
        ? `${live.name} began at ${fmtClock(times[live.key])} · the mosque is open`
        : `at ${fmtClock(times[next.key])} · in ${humanLeft(minsLeft)}`;
      PRAYERS.forEach((p) => {
        const li = $(`[data-pr-key="${p.key}"]`, panel)!;
        $('[data-pr-time]', li)!.textContent = fmtClock(times[p.key]);
        li.setAttribute('aria-current', String((live ?? next).key === p.key));
      });
      section?.setAttribute('data-prayer-active', String(Boolean(live)));
      panel.hidden = false;
    };
    paintPrayer();
    setInterval(paintPrayer, 30_000);
    document.addEventListener('visibilitychange', () => !document.hidden && paintPrayer());
  </script>
</BaseLayout>
