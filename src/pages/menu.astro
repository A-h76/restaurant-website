---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuBrowse from '../components/MenuBrowse.astro';
import MenuItemModal from '../components/menu/MenuItemModal.astro';
import Cta from '../components/Cta.astro';
import { allMenuCategories } from '../data/menu-catalog.js';
import { PHONE_TEL, PHONE_DISPLAY, PHONE_TEL_2, PHONE_DISPLAY_2, WHATSAPP_URL } from '../consts.js';

const browseCategories = allMenuCategories();
---

<BaseLayout
  title="Menu — Smart Cook Dera | Karahi, BBQ, Fast Food | Sahiwal-Arifwala Road"
  description="Full menu at Smart Cook Dera. Fresh Mutton Karahi, Chicken Karahi, BBQ, Seekh Kabab, Naan, Fast Food and Drinks. Sahiwal-Arifwala Road, near Arifwala."
  headerVariant="utility"
  headerSticky={false}
  menuHref="#menu"
>
  <section class="bg-brand-dark px-5 py-section-md md:px-10 lg:px-16">
    <div class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-4">
      <div>
        <span class="font-mono text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-brand-accent">The Bill of Fare</span>
        <h1 class="mt-3 font-display text-display font-medium leading-none text-brand-cream">Our Menu</h1>
      </div>
      <p class="font-mono text-[0.62rem] uppercase leading-relaxed tracking-[0.16em] text-brand-cream/55">
        Karahi · BBQ · Biryani<br />Pizzas · Fast Food · Deals
      </p>
    </div>
  </section>

  <MenuBrowse categories={browseCategories} />

  <p class="bg-brand-cream px-5 pb-10 text-center font-mono text-xs leading-relaxed text-brand-text-muted">
    Prices may vary — please confirm current prices when ordering.<br />
    <a href={PHONE_TEL} class="link-draw text-brand-accent">{PHONE_DISPLAY}</a> · <a href={PHONE_TEL_2} class="link-draw text-brand-accent">{PHONE_DISPLAY_2}</a>
  </p>

  <section class="bg-brand-green px-5 py-section-md text-center md:px-10">
    <p class="font-display text-2xl font-medium text-brand-cream md:text-3xl">Ready to order?</p>
    <p class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-brand-cream/55">Call ahead or send us a message</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <Cta href={PHONE_TEL} variant="primary">Call Now</Cta>
      <Cta href={WHATSAPP_URL} variant="whatsapp" target="_blank" rel="noopener noreferrer">WhatsApp</Cta>
    </div>
  </section>

  <MenuItemModal />
</BaseLayout>
