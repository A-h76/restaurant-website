---
// A dish on the parchi-builder menu. Photo + title open the details modal
// (unchanged data contract); the size chips underneath add to "Your Parchi".
// Cards/List layout is switched by data-view on the #menu wrapper (group/menu).
import DishImage from './menu/DishImage.astro';
import { isVerifiedImage } from '../lib/menu.js';
import { sizeOptions } from '../lib/parchi.js';

interface Props {
  item: {
    id?: string;
    name: string;
    price: string | null;
    description?: string;
    image?: string;
    imageThumb?: string;
    imageStatus?: string;
    imageFit?: 'cover' | 'product';
    items?: string[];
  };
  category: string;
  urdu?: string;
  note?: string;
}

const { item, category, urdu = '', note = '' } = Astro.props;
const display = item.name || category;
const verified = isVerifiedImage(item);
const id = item.id || `${category}-${display}`.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const options = sizeOptions(item.price, note);
const search = `${display} ${category} ${urdu} ${item.description ?? ''}`.toLowerCase();
---

<article
  data-card
  data-card-id={id}
  data-card-name={display}
  data-search={search}
  class="group/card flex flex-col overflow-hidden rounded-2xl border-2 border-brand-text-dark bg-paper-bright shadow-card transition-[transform,box-shadow] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-lift"
>
  <button
    type="button"
    data-menu-item
    data-id={item.id ?? ''}
    data-name={display}
    data-category={category}
    data-urdu={urdu}
    data-price={item.price ?? ''}
    data-note={note}
    data-description={item.description ?? ''}
    data-image={verified ? item.image : ''}
    data-image-thumb={verified ? (item.imageThumb || item.image) : ''}
    data-image-status={item.imageStatus ?? 'needs-review'}
    data-image-fit={item.imageFit ?? 'cover'}
    data-items={item.items ? item.items.join('||') : ''}
    aria-haspopup="dialog"
    aria-label={`${display} — details`}
    class="group flex w-full flex-1 flex-col text-left focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-accent group-data-[view=list]/menu:flex-row group-data-[view=list]/menu:items-center group-data-[view=list]/menu:gap-3 group-data-[view=list]/menu:p-2.5"
  >
    <div class="relative aspect-[3/2] w-full overflow-hidden border-b-2 border-brand-text-dark bg-brand-dark sm:aspect-[4/3] group-data-[view=list]/menu:aspect-square group-data-[view=list]/menu:w-[4.5rem] group-data-[view=list]/menu:shrink-0 group-data-[view=list]/menu:rounded-xl group-data-[view=list]/menu:border-2">
      <DishImage
        src={item.image}
        thumbSrc={item.imageThumb}
        alt=""
        verified={verified}
        sizes="(max-width: 640px) 100vw, (max-width: 1280px) 45vw, 300px"
        imgClass="transition-transform duration-[750ms] ease-out group-hover:scale-[1.07]"
        iconSize={40}
        fit={item.imageFit ?? 'cover'}
      />
    </div>
    <div class="min-w-0 flex-1 p-3.5 pb-2 group-data-[view=list]/menu:p-0">
      <h3 class="font-display text-lg leading-snug text-brand-text-dark sm:text-xl">{display}</h3>
      {item.description && (
        <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-brand-text-muted group-data-[view=list]/menu:hidden">{item.description}</p>
      )}
    </div>
  </button>

  <!-- Size chips: one tap adds that size to the parchi -->
  <div class="flex flex-wrap items-center gap-2 border-t-2 border-dashed border-brand-text-dark/25 px-3.5 py-3 group-data-[view=list]/menu:border-t-0 group-data-[view=list]/menu:px-2.5 group-data-[view=list]/menu:pb-2.5 group-data-[view=list]/menu:pt-0">
    {options.map((o) => (
      <button
        type="button"
        data-add
        data-label={o.label}
        data-price={o.price ?? ''}
        data-raw={o.raw}
        aria-label={`Add ${display}${o.label ? ` (${o.label})` : ''}${o.raw ? `, ${o.raw}` : ''} to your parchi`}
        class="group/chip inline-flex min-h-10 items-center gap-1.5 rounded-full border-2 border-brand-text-dark bg-paper-bright px-3 text-[0.82rem] font-extrabold text-brand-text-dark shadow-card-sm transition-[transform,background-color] duration-150 hover:bg-marigold active:translate-y-px data-[count]:bg-marigold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
      >
        <span class="text-brand-accent" aria-hidden="true">+</span>
        {o.label && <span>{o.label}</span>}
        {o.raw && <span class="tabular-nums" dir="ltr">{o.raw}</span>}
        {!o.raw && <span>Add</span>}
        <span data-badge hidden class="rounded-full bg-brand-dark px-1.5 py-px text-[0.7rem] text-brand-cream"></span>
      </button>
    ))}
  </div>
</article>
