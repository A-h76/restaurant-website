---
import DishImage from './menu/DishImage.astro';
import { isVerifiedImage, formatPrice, priceSegments } from '../lib/menu.js';

interface Props {
  item: {
    id?: string;
    name: string;
    price: string | null;
    description?: string;
    image?: string;
    imageThumb?: string;
    imageStatus?: string;
    imageFit?: 'cover' | 'product';
    items?: string[];
  };
  category: string;
  urdu?: string;
  note?: string;
}

const { item, category, urdu = '', note = '' } = Astro.props;
const display = item.name || category;
const verified = isVerifiedImage(item);
const fromPrice = note ? priceSegments(note)[0]?.price : '';
const priceLabel = item.price ? formatPrice(item.price) : fromPrice ? `From ${fromPrice}` : '';
---

<button
  type="button"
  data-menu-item
  data-id={item.id ?? ''}
  data-name={display}
  data-category={category}
  data-urdu={urdu}
  data-price={item.price ?? ''}
  data-note={note}
  data-description={item.description ?? ''}
  data-image={verified ? item.image : ''}
  data-image-thumb={verified ? (item.imageThumb || item.image) : ''}
  data-image-status={item.imageStatus ?? 'needs-review'}
  data-image-fit={item.imageFit ?? 'cover'}
  data-items={item.items ? item.items.join('||') : ''}
  aria-haspopup="dialog"
  class="group flex w-full flex-col border border-brand-text-dark/15 bg-paper-bright text-left shadow-card transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1 hover:border-brand-accent/70 hover:shadow-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
>
  <div class="relative aspect-[3/2] w-full overflow-hidden bg-brand-dark sm:aspect-[4/3]">
    <DishImage
      src={item.image}
      thumbSrc={item.imageThumb}
      alt={display}
      verified={verified}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 45vw, 320px"
      imgClass="transition-transform duration-[750ms] ease-out group-hover:scale-[1.07]"
      iconSize={40}
      fit={item.imageFit ?? 'cover'}
    />
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-brand-dark/25 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
  </div>
  <div class="flex min-w-0 flex-1 flex-col p-3.5">
    <h3 class="font-display text-lg font-medium leading-snug text-brand-text-dark sm:text-xl">{display}</h3>
    {item.description && (
      <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-brand-text-muted">{item.description}</p>
    )}
    <div class="mt-auto flex flex-wrap items-end justify-between gap-x-2 gap-y-1 border-t border-brand-text-dark/12 pt-3">
      {priceLabel ? (
        <span class="font-mono text-sm font-bold tabular-nums text-brand-text-dark" dir="ltr">{priceLabel}</span>
      ) : (
        <span></span>
      )}
      <span class="ml-auto inline-flex shrink-0 items-center gap-1.5 font-mono text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-brand-accent">
        Order
        <span class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </span>
    </div>
  </div>
</button>
