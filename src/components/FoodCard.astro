---
import DishImage from './menu/DishImage.astro';
import { isVerifiedImage, formatPrice, priceSegments } from '../lib/menu.js';

interface Props {
  item: {
    id?: string;
    name: string;
    price: string | null;
    description?: string;
    image?: string;
    imageThumb?: string;
    imageStatus?: string;
    items?: string[];
  };
  category: string;
  urdu?: string;
  note?: string;
}

const { item, category, urdu = '', note = '' } = Astro.props;
const display = item.name || category;
const verified = isVerifiedImage(item);
const fromPrice = note ? priceSegments(note)[0]?.price : '';
const priceLabel = item.price ? formatPrice(item.price) : fromPrice ? `From ${fromPrice}` : '';
---

<button
  type="button"
  data-menu-item
  data-id={item.id ?? ''}
  data-name={display}
  data-category={category}
  data-urdu={urdu}
  data-price={item.price ?? ''}
  data-note={note}
  data-description={item.description ?? ''}
  data-image={verified ? item.image : ''}
  data-image-thumb={verified ? (item.imageThumb || item.image) : ''}
  data-image-status={item.imageStatus ?? 'needs-review'}
  data-items={item.items ? item.items.join('||') : ''}
  aria-haspopup="dialog"
  class="group flex w-full flex-col rounded-2xl border border-brand-accent/15 bg-white p-2 text-left shadow-[0_1px_8px_-4px_rgba(7,28,20,0.12)] transition-colors duration-200 hover:border-brand-accent/45 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent sm:p-3"
>
  <div class="relative aspect-[16/10] w-full overflow-hidden rounded-xl bg-brand-green sm:aspect-[4/3]">
    <DishImage
      src={item.image}
      thumbSrc={item.imageThumb}
      alt={display}
      verified={verified}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 45vw, 320px"
      imgClass=""
      iconSize={40}
    />
  </div>
  <div class="flex min-w-0 flex-1 flex-col px-1 pb-1 pt-2.5">
    <h3 class="font-display text-lg font-semibold leading-snug text-brand-text-dark sm:text-xl">{display}</h3>
    {item.description && (
      <p class="mt-1 line-clamp-2 font-sans text-sm leading-relaxed text-brand-text-muted">{item.description}</p>
    )}
    <div class="mt-auto flex items-end justify-between gap-2 pt-2">
      {priceLabel && (
        <span class="font-display text-base font-semibold tabular-nums text-brand-accent sm:text-lg" dir="ltr">{priceLabel}</span>
      )}
      <span class="inline-flex min-h-9 shrink-0 items-center rounded-full bg-brand-dark px-3 py-1.5 font-sans text-[11px] font-semibold uppercase tracking-widest text-brand-cream">
        Order
      </span>
    </div>
  </div>
</button>
