---
// Shared masthead for the sub-pages (menu, location, prayer, contact, 404).
// Retro poster header: tilted kicker sticker, chunky title with a hard offset
// shadow, a sub line, and the page's key facts as little ticket chips.
interface Props {
  kicker: string;
  kickerUrdu?: string;
  title: string;
  sub?: string;
  meta?: string[];
  tone?: 'dark' | 'green';
}

const { kicker, kickerUrdu, title, sub, meta = [], tone = 'dark' } = Astro.props;
// 'dark' = the default cream poster; 'green' = the quiet olive register (prayer).
const quiet = tone === 'green';
---

<section class={`relative isolate overflow-hidden ${quiet ? 'bg-brand-green text-brand-cream' : 'bg-paper-dim text-brand-text-dark'} px-5 md:px-10 lg:px-16`}>
  {quiet && <div class="bg-geo pointer-events-none absolute inset-0 opacity-[0.6]" aria-hidden="true"></div>}

  <div class="relative mx-auto max-w-6xl">
    <div class="flex flex-col gap-8 pb-10 pt-12 md:flex-row md:items-end md:justify-between md:gap-12 md:pb-12 md:pt-16">
      <div class="min-w-0">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class={`sticker ${quiet ? 'sticker-white' : ''}`}>★ {kicker}</span>
          {kickerUrdu && <span class={`font-urdu-display text-lg font-normal ${quiet ? 'text-brand-cream/80' : 'text-brand-text-muted'}`} dir="rtl">{kickerUrdu}</span>}
        </p>
        <h1 class={`mt-5 font-display text-[clamp(3rem,9vw,6.25rem)] font-black leading-[0.95] ${quiet ? 'text-brand-cream text-pop-red' : 'text-brand-text-dark text-pop'}`}>{title}</h1>
        {sub && <p class={`mt-4 max-w-xl text-base font-semibold ${quiet ? 'text-brand-cream/85' : 'text-brand-text-muted'}`}>{sub}</p>}
      </div>

      {meta.length > 0 && (
        <ul class="flex shrink-0 flex-wrap gap-2.5 md:max-w-[18rem] md:flex-col md:items-end">
          {meta.map((m, i) => (
            <li class={`rounded-full border-2 border-brand-text-dark bg-paper-bright px-3.5 py-1.5 text-xs font-extrabold uppercase tracking-[0.1em] text-brand-text-dark shadow-card-sm ${i % 2 ? 'rotate-1' : '-rotate-1'}`}>
              <span dir="ltr">{m}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
  <div class="stripes -mx-5 md:-mx-10 lg:-mx-16" aria-hidden="true"></div>
</section>
