---
import { PHONE_TEL, MAPS_DIRECTIONS_URL } from '../consts.js';

interface Props {
  variant?: 'utility' | 'compact';
  sticky?: boolean;
  menuHref?: string;
}

const { sticky = true, menuHref = '/menu' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/location', label: 'Location' },
  { href: '/prayer-facility', label: 'Prayer' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
const headerPosition = sticky ? 'sticky top-0 z-40' : 'relative z-40';
---

<header class={`${headerPosition} border-b border-brand-cream/12 bg-brand-dark/95 backdrop-blur-sm`}>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 md:h-[4.75rem] md:px-8 lg:px-10">
    <!-- Wordmark -->
    <a href="/" class="flex items-baseline gap-2.5 leading-none">
      <span class="font-urdu-display text-xl leading-none text-brand-accent md:text-2xl">سمارٹ کک ڈیرہ</span>
      <span class="hidden font-mono text-[0.58rem] font-semibold uppercase tracking-[0.28em] text-brand-cream/45 sm:inline">
        Smart&nbsp;Cook&nbsp;Dera
      </span>
      <span class="sr-only">Smart Cook Dera — home</span>
    </a>

    <!-- Desktop nav: indexed, mono, underline draws on hover -->
    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-7">
        {navItems.map((item, i) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="group inline-flex items-baseline font-mono text-[0.7rem] font-medium uppercase tracking-[0.16em] text-brand-cream/80 transition-colors hover:text-brand-accent aria-[current=page]:text-brand-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
            >
              <span class="link-draw">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right cluster -->
    <div class="flex items-center gap-2">
      <a
        href={menuHref}
        class="hidden rounded-none bg-brand-accent px-4 py-2 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-brand-cream transition-colors hover:bg-brand-accent-light md:inline-flex"
      >
        View Menu
      </a>
      <a
        href={PHONE_TEL}
        aria-label="Call now"
        class="inline-flex h-10 items-center rounded-none bg-brand-accent px-3.5 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.16em] text-brand-cream md:hidden"
      >
        Call
      </a>
      <button
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
        class="flex h-11 w-11 items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent md:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C33F26" stroke-width="1.75" stroke-linecap="round">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Rendered outside <header> deliberately: the header's backdrop-filter
     creates a containing block for fixed descendants. -->
<nav id="mobile-menu" class="fixed inset-0 z-50 hidden overflow-y-auto bg-brand-dark md:hidden" aria-label="Primary mobile">
  <div class="grain pointer-events-none absolute inset-0 opacity-[0.04] mix-blend-screen" aria-hidden="true"></div>
  <div class="relative flex items-center justify-between border-b border-brand-cream/12 px-4 py-3">
    <span class="font-urdu-display text-xl leading-none text-brand-accent">سمارٹ کک ڈیرہ</span>
    <button
      type="button"
      data-menu-close
      aria-label="Close menu"
      class="flex h-11 w-11 items-center justify-center text-2xl text-brand-accent"
    >
      ✕
    </button>
  </div>
  <ul class="relative flex flex-col px-4 pb-8 pt-2">
    {navItems.map((item, i) => (
      <li class="border-b border-brand-cream/10">
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class="flex items-baseline gap-4 py-5 font-display text-3xl font-medium text-brand-cream aria-[current=page]:text-brand-accent"
        >
          <span class="font-mono text-xs tracking-widest text-brand-accent/70">{String(i + 1).padStart(2, '0')}</span>
          {item.label}
        </a>
      </li>
    ))}
    <li class="mt-6 flex w-full flex-col gap-3">
      <a href={PHONE_TEL} class="rounded-none bg-brand-accent px-8 py-3.5 text-center font-mono text-xs font-semibold uppercase tracking-[0.18em] text-brand-cream">
        Call Now
      </a>
      <a href={MAPS_DIRECTIONS_URL} class="rounded-none border border-brand-cream/30 px-8 py-3.5 text-center font-mono text-xs font-semibold uppercase tracking-[0.18em] text-brand-cream">
        Get Directions
      </a>
    </li>
  </ul>
</nav>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = menu?.querySelector('[data-menu-close]');

  function setOpen(isOpen) {
    menu?.classList.toggle('hidden', !isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('overflow-hidden', isOpen);
  }

  btn?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') === true);
  });
  closeBtn?.addEventListener('click', () => setOpen(false));
</script>
