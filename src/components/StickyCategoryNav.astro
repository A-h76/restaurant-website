---
interface Props {
  categories: { id: string; label: string }[];
}

const { categories } = Astro.props;
const navCategories = categories.map((cat) => ({
  ...cat,
  display: cat.label.endsWith("'s") ? cat.label.slice(0, -2) : cat.label,
}));
---

<nav
  id="sticky-category-nav"
  aria-label="Menu categories"
  class="sticky top-0 z-40 border-b border-brand-accent/20 bg-brand-cream/95 shadow-[0_6px_16px_-10px_rgba(7,28,20,0.35)] backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-6xl items-center gap-2 px-2 py-2 md:px-6">
    <a href="/" class="hidden shrink-0 px-2 font-urdu-display text-lg leading-none text-brand-accent lg:block">سمارٹ کک ڈیرہ</a>

    <button
      type="button"
      data-cat-scroll="-1"
      aria-label="Previous categories"
      class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-full border border-brand-accent/25 text-brand-text-dark hover:bg-white md:flex"
    >
      ‹
    </button>

    <div
      id="category-scroller"
      data-fade="right"
      class="scrollbar-none fade-edges flex min-w-0 flex-1 gap-1.5 overflow-x-auto overscroll-x-contain scroll-smooth py-0.5 md:[mask-image:none]"
    >
      {navCategories.map((cat, i) => (
        <a
          href={`#${cat.id}`}
          data-cat-link
          class="cat-link shrink-0 rounded-full px-3.5 py-2 font-sans text-xs font-semibold uppercase tracking-wide text-brand-text-muted whitespace-nowrap transition-colors hover:text-brand-text-dark aria-[current=true]:bg-brand-dark aria-[current=true]:text-brand-cream"
          aria-current={i === 0 ? 'true' : undefined}
        >
          {cat.display}
        </a>
      ))}
    </div>

    <button
      type="button"
      data-cat-scroll="1"
      aria-label="Next categories"
      class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-full border border-brand-accent/25 text-brand-text-dark hover:bg-white md:flex"
    >
      ›
    </button>
  </div>
</nav>

<script>
  const nav = document.getElementById('sticky-category-nav');
  const scroller = document.getElementById('category-scroller');
  const links = nav ? Array.from(nav.querySelectorAll('[data-cat-link]')) : [];
  const sections = links
    .map((link) => document.getElementById(link.getAttribute('href')?.slice(1) ?? ''))
    .filter(Boolean);

  if (nav && scroller && links.length && sections.length) {
    let activeId = sections[0].id;
    let clicking = false;

    function setActive(id) {
      if (id === activeId) return;
      activeId = id;
      links.forEach((link) => {
        const on = link.getAttribute('href') === `#${id}`;
        link.setAttribute('aria-current', on ? 'true' : 'false');
        if (on) {
          const linkRect = link.getBoundingClientRect();
          const scrollerRect = scroller.getBoundingClientRect();
          const delta = linkRect.left - scrollerRect.left - scrollerRect.width / 2 + linkRect.width / 2;
          scroller.scrollBy({ left: delta, behavior: 'smooth' });
        }
      });
    }

    function navOffset() {
      return nav.getBoundingClientRect().height + 6;
    }

    function onScroll() {
      if (clicking) return;
      const y = navOffset();
      let current = sections[0];
      sections.forEach((section) => {
        if (section.getBoundingClientRect().top <= y) current = section;
      });
      setActive(current.id);
    }

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.getAttribute('href')?.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        e.preventDefault();
        clicking = true;
        setActive(id);
        history.replaceState(null, '', `#${id}`);
        const top = window.scrollY + target.getBoundingClientRect().top - navOffset();
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
        window.setTimeout(() => {
          clicking = false;
        }, 900);
      });
    });

    nav.querySelectorAll('[data-cat-scroll]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-cat-scroll'));
        scroller.scrollBy({ left: dir * 220, behavior: 'smooth' });
      });
    });

    function updateFade() {
      const atStart = scroller.scrollLeft <= 2;
      const atEnd = scroller.scrollLeft >= scroller.scrollWidth - scroller.clientWidth - 2;
      scroller.dataset.fade = atStart && atEnd ? 'none' : atStart ? 'right' : atEnd ? 'left' : 'both';
    }
    scroller.addEventListener('scroll', updateFade, { passive: true });
    updateFade();
    window.addEventListener('resize', updateFade, { passive: true });

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const hashId = window.location.hash.slice(1);
    const hashTarget = hashId ? document.getElementById(hashId) : null;
    if (hashTarget) {
      setActive(hashId);
      requestAnimationFrame(() => {
        const top = window.scrollY + hashTarget.getBoundingClientRect().top - navOffset();
        window.scrollTo({ top: Math.max(0, top) });
      });
    }
  }
</script>
