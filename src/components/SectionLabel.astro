---
interface Props {
  label: string;
  urdu?: string;
  tone?: 'light' | 'dark';
}

const { label, urdu, tone = 'light' } = Astro.props;
const urduColor = tone === 'dark' ? 'text-brand-cream/80' : 'text-brand-text-muted';
---

<div class="mb-6 flex flex-wrap items-center justify-center gap-3">
  <span class={`sticker ${tone === 'dark' ? 'sticker-white' : ''}`}>★ {label}</span>
  {urdu && <span class={`font-urdu-display text-lg ${urduColor}`} dir="rtl">{urdu}</span>}
</div>
