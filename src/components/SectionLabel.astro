---
interface Props {
  label: string;
  urdu?: string;
  tone?: 'light' | 'dark';
}

const { label, urdu, tone = 'light' } = Astro.props;
const labelColor = tone === 'dark' ? 'text-brand-accent-light' : 'text-brand-accent';
const ruleColor = tone === 'dark' ? 'bg-brand-accent-light' : 'bg-brand-accent';
const urduColor = tone === 'dark' ? 'text-brand-cream/70' : 'text-brand-text-muted';
---

<div class="mb-6 flex items-center justify-center gap-3">
  <span class={`h-px w-8 ${ruleColor}`} aria-hidden="true"></span>
  <span class={`font-mono text-[0.66rem] font-semibold uppercase tracking-[0.24em] ${labelColor}`}>{label}</span>
  {urdu && <span class={`font-urdu-display text-sm ${urduColor}`} dir="rtl">{urdu}</span>}
  <span class={`h-px w-8 ${ruleColor}`} aria-hidden="true"></span>
</div>
