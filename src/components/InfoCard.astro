---
// Shared "icon + heading + text" card — used by /location, /contact and
// /prayer-facility. Squared, hairline-bordered, editorial.
interface Props {
  icon: string; // raw inline <svg>...</svg> markup, stroke set to currentColor
  heading: string;
  tone?: 'dark' | 'light';
  align?: 'left' | 'center';
  class?: string;
}

const { icon, heading, tone = 'dark', align = 'left', class: className = '' } = Astro.props;
const toneClass = tone === 'dark'
  ? 'bg-brand-green text-brand-cream border-brand-cream/15'
  : 'bg-paper-bright text-brand-text-dark border-brand-text-dark/15';
const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<div data-rise class={`flex flex-col border p-6 md:p-7 ${toneClass} ${alignClass} ${className}`}>
  <span class="text-brand-accent" aria-hidden="true" set:html={icon} />
  <h3 class="mt-4 font-display text-xl font-medium">{heading}</h3>
  <div class="mt-2 text-sm leading-relaxed opacity-85">
    <slot />
  </div>
</div>
