---
import StickyCategoryNav from './StickyCategoryNav.astro';
import FoodCard from './FoodCard.astro';
import { withSectionIds, formatPrice } from '../lib/menu.js';
import { desiCategories, fastFoodCategories } from '../data/menu-catalog.js';

interface Props {
  categories: {
    name: string;
    urdu?: string;
    note?: string;
    items: {
      id?: string;
      name: string;
      price: string | null;
      description?: string;
      image?: string;
      imageThumb?: string;
      imageStatus?: string;
      items?: string[];
    }[];
  }[];
}

const { categories } = Astro.props;
const sections = withSectionIds(categories);
const desiEnd = desiCategories.length;
const fastFoodEnd = desiEnd + fastFoodCategories.length;
---

<div id="menu">
<StickyCategoryNav categories={sections.map((c) => ({ id: c.id, label: c.name }))} />

<div class="bg-brand-cream px-4 py-section-md md:px-8 lg:px-16">
  <div class="mx-auto max-w-6xl space-y-12">
    {sections.map((cat, i) => (
      <>
        {i === 0 && (
          <div class="-mx-4 flex items-center gap-4 bg-brand-dark px-4 py-3 md:-mx-8 md:px-8 lg:-mx-16 lg:px-16">
            <h2 class="shrink-0 font-display text-base font-semibold uppercase tracking-[0.3em] text-brand-accent">Our Karahi &amp; BBQ</h2>
            <span class="h-px flex-1 bg-brand-accent/30" aria-hidden="true"></span>
          </div>
        )}
        {i === desiEnd && (
          <div class="-mx-4 flex items-center gap-4 bg-brand-dark px-4 py-3 md:-mx-8 md:px-8 lg:-mx-16 lg:px-16">
            <h2 class="shrink-0 font-display text-base font-semibold uppercase tracking-[0.3em] text-brand-accent">Fast Food</h2>
            <span class="h-px flex-1 bg-brand-accent/30" aria-hidden="true"></span>
          </div>
        )}
        {i === fastFoodEnd && (
          <div class="-mx-4 flex items-center gap-4 bg-brand-dark px-4 py-3 md:-mx-8 md:px-8 lg:-mx-16 lg:px-16">
            <h2 class="shrink-0 font-display text-base font-semibold uppercase tracking-[0.3em] text-brand-accent">Deals</h2>
            <span class="h-px flex-1 bg-brand-accent/30" aria-hidden="true"></span>
          </div>
        )}
        <section id={cat.id} data-menu-section>
        <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-l-4 border-brand-accent pl-3">
          <h3 class="font-display text-xl font-bold text-brand-text-dark md:text-2xl">{cat.name}</h3>
          {cat.urdu && <span class="font-urdu-display text-sm text-brand-text-muted" dir="rtl">{cat.urdu}</span>}
        </div>
        {cat.note && (
          <p class="mb-4 font-sans text-sm text-brand-text-muted">{formatPrice(cat.note)}</p>
        )}
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {cat.items.map((item) => (
            <FoodCard item={item} category={cat.name} urdu={cat.urdu} note={cat.note} />
          ))}
        </div>
        </section>
      </>
    ))}
  </div>
</div>
</div>
