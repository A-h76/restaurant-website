---
import StickyCategoryNav from './StickyCategoryNav.astro';
import FoodCard from './FoodCard.astro';
import { withSectionIds, formatPrice } from '../lib/menu.js';
import { desiCategories, fastFoodCategories } from '../data/menu-catalog.js';

interface Props {
  categories: {
    name: string;
    urdu?: string;
    note?: string;
    items: {
      id?: string;
      name: string;
      price: string | null;
      description?: string;
      image?: string;
      imageThumb?: string;
      imageStatus?: string;
      items?: string[];
    }[];
  }[];
}

const { categories } = Astro.props;
const sections = withSectionIds(categories);
const desiEnd = desiCategories.length;
const fastFoodEnd = desiEnd + fastFoodCategories.length;
---

<div id="menu">
<StickyCategoryNav categories={sections.map((c) => ({ id: c.id, label: c.name }))} />

<div class="bg-brand-cream px-4 py-section-md md:px-8 lg:px-16">
  <div class="mx-auto max-w-6xl space-y-14">
    {sections.map((cat, i) => (
      <>
        {i === 0 && (
          <div class="-mx-4 flex items-baseline gap-4 border-b-2 border-brand-text-dark px-1 pb-2 md:-mx-8 md:px-1 lg:-mx-16 lg:px-1">
            <span class="font-mono text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-brand-accent">§ 01</span>
            <h2 class="font-display text-2xl font-medium text-brand-text-dark md:text-3xl">Karahi &amp; BBQ</h2>
          </div>
        )}
        {i === desiEnd && (
          <div class="-mx-4 flex items-baseline gap-4 border-b-2 border-brand-text-dark px-1 pb-2 md:-mx-8 md:px-1 lg:-mx-16 lg:px-1">
            <span class="font-mono text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-brand-accent">§ 02</span>
            <h2 class="font-display text-2xl font-medium text-brand-text-dark md:text-3xl">Fast Food</h2>
          </div>
        )}
        {i === fastFoodEnd && (
          <div class="-mx-4 flex items-baseline gap-4 border-b-2 border-brand-text-dark px-1 pb-2 md:-mx-8 md:px-1 lg:-mx-16 lg:px-1">
            <span class="font-mono text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-brand-accent">§ 03</span>
            <h2 class="font-display text-2xl font-medium text-brand-text-dark md:text-3xl">Deals</h2>
          </div>
        )}
        <section id={cat.id} data-menu-section>
        <div class="mb-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="font-display text-xl font-medium text-brand-text-dark md:text-2xl">{cat.name}</h3>
          {cat.urdu && <span class="font-urdu-display text-sm text-brand-text-muted" dir="rtl">{cat.urdu}</span>}
          <span class="ml-auto font-mono text-[0.6rem] uppercase tracking-[0.16em] text-brand-text-muted">{cat.items.length} {cat.items.length === 1 ? 'item' : 'items'}</span>
        </div>
        {cat.note && (
          <p class="mb-4 font-mono text-xs text-brand-text-muted">{formatPrice(cat.note)}</p>
        )}
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {cat.items.map((item) => (
            <FoodCard item={item} category={cat.name} urdu={cat.urdu} note={cat.note} />
          ))}
        </div>
        </section>
      </>
    ))}
  </div>
</div>
</div>
