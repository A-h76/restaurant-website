---
import { PHONE_TEL, WHATSAPP_URL, MAPS_DIRECTIONS_URL } from '../consts.js';
---

<div class="fixed inset-x-0 bottom-0 z-50 border-t border-brand-accent/20 bg-brand-dark/95 px-3 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-sm md:hidden">
  <div class="mx-auto grid max-w-lg grid-cols-3 gap-2">
    <a href={PHONE_TEL} class="flex min-h-11 items-center justify-center rounded-xl bg-brand-accent font-sans text-xs font-semibold uppercase tracking-widest text-brand-dark">
      Call
    </a>
    <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center justify-center rounded-xl bg-whatsapp font-sans text-xs font-semibold uppercase tracking-widest text-white">
      WhatsApp
    </a>
    <a href={MAPS_DIRECTIONS_URL} class="flex min-h-11 items-center justify-center rounded-xl border border-brand-accent/50 font-sans text-xs font-semibold uppercase tracking-widest text-brand-accent">
      Directions
    </a>
  </div>
</div>

<button
  type="button"
  id="back-to-top-mobile"
  aria-label="Back to top"
  hidden
  class="fixed bottom-[4.75rem] right-3 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-brand-dark/90 ring-1 ring-brand-accent/40 backdrop-blur-sm md:hidden"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A84E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<div class="fixed bottom-6 right-5 z-50 hidden flex-col gap-3 md:flex">
  <a
    href={WHATSAPP_URL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WhatsApp Us"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-whatsapp shadow-lg shadow-whatsapp/30"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.1c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.13.11-1.82-.12-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.16-4.94-4.35-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.26-.28.57-.35.76-.35h.55c.18 0 .42-.07.65.5.24.58.82 2 .89 2.15.07.14.11.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.14-.29.29-.12.57.17.28.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.33 1.44.28.14.44.12.61-.07.16-.19.7-.81.89-1.09.19-.28.37-.23.62-.14.26.09 1.63.77 1.91.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/>
    </svg>
  </a>
  <a
    href={PHONE_TEL}
    aria-label="Call Now"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-accent shadow-lg shadow-brand-accent/30"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="#071C14" aria-hidden="true">
      <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02l-2.2 2.2z"/>
    </svg>
  </a>
  <a
    href={MAPS_DIRECTIONS_URL}
    aria-label="Get directions"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-green ring-1 ring-brand-accent/40"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#C9A84E" aria-hidden="true">
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/>
    </svg>
  </a>
  <button
    type="button"
    id="back-to-top"
    aria-label="Back to top"
    hidden
    class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-dark ring-1 ring-brand-accent/40"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A84E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>
</div>

<script>
  const backToTopButtons = [document.getElementById('back-to-top'), document.getElementById('back-to-top-mobile')].filter(Boolean);
  if (backToTopButtons.length) {
    window.addEventListener(
      'scroll',
      () => {
        const show = window.scrollY >= 900;
        backToTopButtons.forEach((btn) => {
          btn.hidden = !show;
        });
      },
      { passive: true },
    );
    backToTopButtons.forEach((btn) => {
      btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    });
  }
</script>
