---
// "Your Parchi": the live order slip. Desktop = sticky ticket beside the menu;
// <lg = a bottom sheet opened from the pill bar. Content is filled by the
// MenuBrowse script; the WhatsApp link carries the whole order as a message.
import { WHATSAPP_URL, PHONE_TEL, PHONE_DISPLAY } from '../consts.js';
---

<div id="parchi-backdrop" hidden class="fixed inset-0 z-50 bg-brand-dark/60 lg:hidden"></div>

<aside id="parchi" data-wa={WHATSAPP_URL} aria-label="Your parchi" class="parchi-sheet ticket flex flex-col overflow-hidden [--sh:var(--color-olive)] lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:self-start">
  <div class="flex items-center justify-between gap-3 border-b-2 border-brand-text-dark bg-brand-mid px-5 py-3 text-brand-cream">
    <span class="font-display text-2xl font-black italic">Your Parchi</span>
    <span class="flex items-center gap-3">
      <span data-p-count class="text-[0.68rem] font-extrabold uppercase tracking-[0.18em]">Empty</span>
      <button type="button" data-p-close aria-label="Close your parchi" class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-brand-text-dark bg-marigold text-lg font-black text-brand-text-dark lg:hidden">✕</button>
    </span>
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4">
    <div data-p-empty class="py-6 text-center">
      <p class="font-display text-xl font-black text-brand-text-dark">Nothing here yet.</p>
      <p class="mx-auto mt-2 max-w-[15rem] text-sm leading-relaxed text-brand-text-muted">Tap a size chip like <span class="rounded-full border-2 border-brand-text-dark bg-paper-bright px-2 py-0.5 text-xs font-extrabold text-brand-text-dark"><span class="text-brand-accent">+</span> Full</span> on any dish to add it.</p>
    </div>
    <ul data-p-lines class="divide-y-2 divide-dashed divide-brand-text-dark/25"></ul>
  </div>

  <div data-p-footer hidden class="border-t-2 border-dashed border-brand-text-dark px-5 pb-5 pt-4">
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-[0.7rem] font-extrabold uppercase tracking-[0.18em] text-brand-text-muted">Estimated total</span>
      <span data-p-total class="font-display text-3xl font-black text-brand-accent tabular-nums" dir="ltr">₨0</span>
    </div>
    <p data-p-confirm hidden class="mt-1 text-xs font-semibold text-brand-text-muted"></p>
    <p class="mt-1 text-xs text-brand-text-muted">Prices may vary — we confirm the final total when you send.</p>

    <a
      data-p-send
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex min-h-12 items-center justify-center gap-2 rounded-full border-2 border-brand-text-dark bg-whatsapp px-6 py-3 text-[0.95rem] font-bold text-white shadow-cta transition-[transform,box-shadow] duration-150 hover:-translate-y-0.5 hover:shadow-lift active:translate-y-0.5 active:shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
    >
      Send on WhatsApp
    </a>
    <div class="mt-3 flex items-center justify-between gap-3 text-sm font-bold">
      <a href={PHONE_TEL} class="link-draw text-brand-text-dark" dir="ltr">Or call {PHONE_DISPLAY}</a>
      <button type="button" data-p-clear class="link-draw text-brand-text-muted">Clear</button>
    </div>
    <div class="barcode mt-4" aria-hidden="true"></div>
  </div>
</aside>

<template id="parchi-line">
  <li class="py-3">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p data-l-name class="font-display text-lg font-black leading-tight text-brand-text-dark"></p>
        <p data-l-label class="mt-0.5 text-[0.68rem] font-extrabold uppercase tracking-[0.14em] text-brand-text-muted"></p>
      </div>
      <p data-l-price class="shrink-0 text-right text-sm font-extrabold tabular-nums text-brand-text-dark" dir="ltr"></p>
    </div>
    <div class="mt-2 inline-flex items-center rounded-full border-2 border-brand-text-dark bg-paper-bright">
      <button type="button" data-l-dec aria-label="Remove one" class="flex h-9 w-9 items-center justify-center rounded-full text-lg font-black hover:bg-marigold">−</button>
      <span data-l-qty class="min-w-8 text-center text-sm font-extrabold tabular-nums" aria-live="polite"></span>
      <button type="button" data-l-inc aria-label="Add one more" class="flex h-9 w-9 items-center justify-center rounded-full text-lg font-black hover:bg-marigold">+</button>
    </div>
  </li>
</template>

<!-- <lg: the pill bar that opens the sheet. Shown only once something is added. -->
<div id="parchi-bar" hidden class="fixed inset-x-3 bottom-[calc(0.75rem+env(safe-area-inset-bottom))] z-[45] lg:hidden">
  <button
    type="button"
    data-p-open
    aria-controls="parchi"
    aria-expanded="false"
    class="flex min-h-14 w-full items-center justify-between gap-3 rounded-full border-2 border-brand-text-dark bg-brand-accent px-5 text-brand-cream shadow-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-text-dark"
  >
    <span class="text-sm font-extrabold">Your parchi · <span data-bar-count>0</span> <span data-bar-noun>items</span></span>
    <span class="flex items-center gap-2 font-display text-lg font-black tabular-nums" dir="ltr"><span data-bar-total>₨0</span><span aria-hidden="true">↑</span></span>
  </button>
</div>
