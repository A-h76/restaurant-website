---
import { PHONE_DISPLAY, PHONE_TEL, WHATSAPP_URL, WHATSAPP_DISPLAY, ADDRESS_LINE, HOURS_DISPLAY, PLUS_CODE } from '../consts.js';
const year = new Date().getFullYear();

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/location', label: 'Location' },
  { href: '/prayer-facility', label: 'Prayer Facility' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="relative overflow-hidden bg-brand-dark text-brand-cream">
  <div class="grain pointer-events-none absolute inset-0 opacity-[0.04] mix-blend-screen" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 md:px-10 lg:px-16">
    <!-- Closing statement -->
    <div class="border-b border-brand-cream/12 py-10 md:py-14">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.3em] text-brand-accent">Kilometre after kilometre</p>
      <p class="mt-4 max-w-2xl font-display text-3xl font-medium leading-[1.15] text-brand-cream md:text-5xl">
        Good food, good rest —<br class="hidden sm:block" /> a stop worth pulling over for.
      </p>
    </div>

    <!-- Columns -->
    <div class="grid gap-10 py-10 md:grid-cols-[1.4fr_1fr_1fr] md:py-12">
      <div>
        <span class="font-urdu-display text-2xl leading-none text-brand-accent">سمارٹ کک ڈیرہ</span>
        <p class="mt-3 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-brand-cream/50">Smart Cook Dera</p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-brand-cream/65">{ADDRESS_LINE}</p>
      </div>

      <nav aria-label="Footer">
        <span class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-brand-cream/40">Index</span>
        <ul class="mt-4 space-y-2.5">
          {navItems.map((item, i) => (
            <li>
              <a href={item.href} class="group inline-flex items-baseline gap-2 font-mono text-sm text-brand-cream/85 transition-colors hover:text-brand-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent">
                <span class="text-[0.6rem] text-brand-accent/50">{String(i + 1).padStart(2, '0')}</span>
                <span class="link-draw">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <span class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-brand-cream/40">Direct line</span>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href={PHONE_TEL} class="link-draw font-mono text-brand-cream/85 transition-colors hover:text-brand-accent">{PHONE_DISPLAY}</a></li>
          <li><a href={WHATSAPP_URL} class="link-draw font-mono text-brand-cream/85 transition-colors hover:text-brand-accent">WhatsApp · {WHATSAPP_DISPLAY}</a></li>
          <li class="pt-1 font-mono text-xs text-brand-cream/50">{HOURS_DISPLAY}</li>
        </ul>
      </div>
    </div>

    <!-- Dateline -->
    <div class="flex flex-col gap-2 border-t border-brand-cream/12 py-5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-brand-cream/40 sm:flex-row sm:items-center sm:justify-between">
      <span>&copy; {year} Smart Cook Dera · Halal Kitchen</span>
      <span>Sahiwal–Arifwala Rd · {PLUS_CODE}</span>
    </div>
  </div>
</footer>
