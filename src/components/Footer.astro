---
import { PHONE_DISPLAY, PHONE_TEL, WHATSAPP_URL, WHATSAPP_DISPLAY, ADDRESS_LINE, HOURS_DISPLAY, PLUS_CODE } from '../consts.js';
const year = new Date().getFullYear();

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/location', label: 'Location' },
  { href: '/prayer-facility', label: 'Prayer Facility' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="relative bg-brand-dark text-brand-cream">
  <div class="stripes" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-5 md:px-10 lg:px-16">
    <!-- Closing statement -->
    <div class="border-b-2 border-dashed border-brand-cream/25 py-10 md:py-14">
      <p class="sticker">★ Kilometre after kilometre</p>
      <p class="mt-6 max-w-2xl font-display text-4xl font-black leading-[1.08] text-brand-cream text-pop-red md:text-6xl">
        Good food, good rest —<br class="hidden sm:block" /> a stop worth pulling over for.
      </p>
    </div>

    <!-- Columns -->
    <div class="grid gap-10 py-10 md:grid-cols-[1.4fr_1fr_1fr] md:py-12">
      <div>
        <span class="font-urdu-display text-3xl leading-[1.7] text-brand-accent-light">سمارٹ کک ڈیرہ</span>
        <p class="mt-1 font-display text-xl font-black">Smart Cook Dera</p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-brand-cream/75">{ADDRESS_LINE}</p>
      </div>

      <nav aria-label="Footer">
        <span class="font-mono text-[0.7rem] font-extrabold uppercase tracking-[0.22em] text-brand-accent-light">Index</span>
        <ul class="mt-4 space-y-2.5">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="group inline-flex items-baseline gap-2 text-base font-bold text-brand-cream transition-colors hover:text-brand-accent-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent-light">
                <span class="text-marigold" aria-hidden="true">★</span>
                <span class="link-draw">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <span class="font-mono text-[0.7rem] font-extrabold uppercase tracking-[0.22em] text-brand-accent-light">Direct line</span>
        <ul class="mt-4 space-y-2.5 text-base">
          <li><a href={PHONE_TEL} class="link-draw font-bold text-brand-cream transition-colors hover:text-brand-accent-light" dir="ltr">{PHONE_DISPLAY}</a></li>
          <li><a href={WHATSAPP_URL} class="link-draw font-bold text-brand-cream transition-colors hover:text-brand-accent-light">WhatsApp · <span dir="ltr">{WHATSAPP_DISPLAY}</span></a></li>
          <li class="pt-1 text-sm text-brand-cream/70">{HOURS_DISPLAY}</li>
        </ul>
      </div>
    </div>

    <!-- Dateline -->
    <div class="flex flex-col gap-2 border-t-2 border-dashed border-brand-cream/25 py-5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-brand-cream/65 sm:flex-row sm:items-center sm:justify-between">
      <span>&copy; {year} Smart Cook Dera · Halal Kitchen</span>
      <span>Sahiwal–Arifwala Rd · <span dir="ltr">{PLUS_CODE}</span></span>
    </div>
  </div>
</footer>
