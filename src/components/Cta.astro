---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark' | 'whatsapp';
  /** Only used by variant="ghost", which has no color of its own — every
      other variant sets its own text color and this is ignored. */
  tone?: 'cream' | 'accent' | 'dark';
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant = 'primary', tone = 'accent', class: className = '', target, rel } = Astro.props;

const toneClass: Record<NonNullable<Props['tone']>, string> = {
  cream: 'text-brand-cream',
  accent: 'text-brand-accent',
  dark: 'text-brand-text-dark',
};

function variantClass(kind: NonNullable<Props['variant']>) {
  switch (kind) {
    case 'primary':
      return 'bg-brand-accent text-brand-cream hover:bg-brand-accent-light active:translate-y-px shadow-cta';
    case 'secondary':
      return 'border border-brand-text-dark/30 text-brand-text-dark hover:bg-brand-text-dark hover:text-brand-cream active:translate-y-px';
    case 'ghost':
      // Ghost is an inline mono link — its underline draws from the left.
      return `${toneClass[tone]} link-draw !px-0 !py-0 !min-h-0 hover:text-brand-accent`;
    case 'dark':
      return 'bg-brand-dark text-brand-cream hover:bg-brand-green active:translate-y-px';
    case 'whatsapp':
      return 'bg-whatsapp text-white hover:brightness-110 active:translate-y-px';
    default: {
      const _exhaustive: never = kind;
      return _exhaustive;
    }
  }
}
---

<a
  href={href}
  target={target}
  rel={rel}
  class={`inline-flex min-h-11 items-center justify-center gap-2 rounded-none px-6 py-3 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.18em] transition-all duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent ${variantClass(variant)} ${className}`}
>
  <slot />
</a>
