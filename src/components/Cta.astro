---
// Pill buttons, inked and lifted with a hard shadow. They press down on click.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark' | 'whatsapp';
  /** Only used by variant="ghost", which has no colour of its own — every
      other variant sets its own text colour and this is ignored. */
  tone?: 'cream' | 'accent' | 'dark';
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant = 'primary', tone = 'accent', class: className = '', target, rel } = Astro.props;

const toneClass: Record<NonNullable<Props['tone']>, string> = {
  cream: 'text-brand-cream',
  accent: 'text-brand-accent',
  dark: 'text-brand-text-dark',
};

const pill =
  'rounded-full border-2 border-brand-text-dark px-6 py-3 transition-[transform,box-shadow] duration-150 hover:-translate-y-0.5 hover:shadow-lift active:translate-y-0.5 active:shadow-none';

function variantClass(kind: NonNullable<Props['variant']>) {
  switch (kind) {
    case 'primary':
      return `${pill} bg-brand-accent text-brand-cream shadow-cta`;
    case 'secondary':
      return `${pill} bg-paper-bright text-brand-text-dark shadow-hard-olive`;
    case 'dark':
      return `${pill} bg-brand-dark text-brand-cream shadow-cta`;
    case 'whatsapp':
      return `${pill} bg-whatsapp text-white shadow-cta`;
    case 'ghost':
      // Ghost is an inline text link — its underline draws from the left.
      return `${toneClass[tone]} link-draw !px-0 !py-0 !min-h-0 hover:text-brand-accent`;
    default: {
      const _exhaustive: never = kind;
      return _exhaustive;
    }
  }
}
---

<a
  href={href}
  target={target}
  rel={rel}
  class={`inline-flex min-h-11 items-center justify-center gap-2 text-[0.95rem] font-bold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent ${variantClass(variant)} ${className}`}
>
  <slot />
</a>
