---
// The glovebox: one pill replaces the old stack of four round buttons. Tap it
// and a flap hinges open with everything a driver needs — call, WhatsApp,
// directions, the Plus Code (one-tap copy) and a way back to the top.
import { PHONE_TEL, PHONE_DISPLAY, PHONE_TEL_2, PHONE_DISPLAY_2, WHATSAPP_URL, MAPS_DIRECTIONS_URL, PLUS_CODE } from '../consts.js';
---

<div id="glovebox" class="fixed right-3 z-[45] bottom-[calc(5.625rem+env(safe-area-inset-bottom))] md:bottom-6 md:right-5">
  <div
    id="glove-panel"
    role="group"
    aria-label="Quick contact"
    class="glove-panel absolute bottom-full right-0 mb-3 w-[min(19rem,calc(100vw-1.5rem))] border border-brand-text-dark/25 border-t-4 border-t-brand-accent bg-paper-bright p-4 text-brand-text-dark shadow-2xl"
  >
    <p class="font-mono text-[0.6rem] font-semibold uppercase tracking-[0.26em] text-brand-accent">The Glovebox</p>
    <p class="mt-0.5 font-display text-lg leading-tight">Everything for the road</p>

    <a
      href={PHONE_TEL}
      class="mt-3 flex min-h-11 items-center justify-between gap-3 bg-brand-accent px-4 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-brand-cream transition-colors hover:bg-brand-accent-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
    >
      <span>Call now</span><span dir="ltr">{PHONE_DISPLAY}</span>
    </a>

    <div class="mt-2 grid grid-cols-2 gap-2">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center justify-center bg-whatsapp px-3 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-white transition hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
      >
        WhatsApp
      </a>
      <a
        href={MAPS_DIRECTIONS_URL}
        class="flex min-h-11 items-center justify-center bg-brand-dark px-3 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-brand-cream transition-colors hover:bg-brand-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
      >
        Directions
      </a>
    </div>

    <div class="mt-3 flex items-center justify-between gap-3 border-t border-brand-text-dark/15 pt-3">
      <div>
        <span class="block font-mono text-[0.56rem] uppercase tracking-[0.2em] text-brand-text-muted">Plus Code</span>
        <span class="font-mono text-sm font-bold" dir="ltr">{PLUS_CODE}</span>
      </div>
      <button
        type="button"
        data-copy={PLUS_CODE}
        class="min-h-11 border border-brand-text-dark/30 px-3 font-mono text-[0.62rem] font-semibold uppercase tracking-[0.14em] transition-colors hover:bg-brand-text-dark hover:text-brand-cream focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
      >
        Copy
      </button>
    </div>

    <div class="mt-1 flex items-center justify-between font-mono text-[0.62rem] uppercase tracking-[0.14em] text-brand-text-muted">
      <a href={PHONE_TEL_2} class="link-draw py-2" dir="ltr">{PHONE_DISPLAY_2}</a>
      <button type="button" data-glove-top class="link-draw py-2">Back to top ↑</button>
    </div>
  </div>

  <button
    type="button"
    id="glove-toggle"
    aria-expanded="false"
    aria-controls="glove-panel"
    class="group flex min-h-12 items-center gap-2.5 border border-brand-accent/70 bg-brand-dark px-4 font-mono text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-brand-cream shadow-lg shadow-brand-dark/30 transition-colors hover:bg-brand-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="6" width="18" height="12" rx="1.5"></rect>
      <path d="M3 10h18M10 14h4"></path>
    </svg>
    <span class="group-aria-expanded:hidden">Call · Map · Chat</span>
    <span class="hidden group-aria-expanded:inline">Close ✕</span>
  </button>
</div>

<script>
  const box = document.getElementById('glovebox');
  const toggle = document.getElementById('glove-toggle');
  const panel = document.getElementById('glove-panel');

  function setOpen(open) {
    if (!box || !toggle || !panel) return;
    panel.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  }
  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  document.addEventListener('click', (e) => {
    if (isOpen() && box && !box.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  panel?.querySelector('[data-glove-top]')?.addEventListener('click', () => {
    setOpen(false);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  panel?.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLElement;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      btn.textContent = 'Copied ✓';
    } catch {
      btn.textContent = 'Press & hold';
    }
    setTimeout(() => (btn.textContent = 'Copy'), 1800);
  });
</script>
