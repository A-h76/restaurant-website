---
// The glovebox: one segmented pill — Call · Map · Chat — three one-tap actions
// a driver can hit without thinking. Fixed bottom-right on every page.
import { PHONE_TEL, WHATSAPP_URL, MAPS_DIRECTIONS_URL } from '../consts.js';

const seg =
  'flex min-h-10 items-center justify-center rounded-full px-4 text-sm font-bold text-brand-text-dark transition-colors hover:bg-marigold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent';
---

<nav
  aria-label="Quick contact"
  class="fixed right-3 z-[45] flex items-center gap-0.5 rounded-full border-2 border-brand-text-dark bg-paper-bright p-1 shadow-soft bottom-[calc(5.625rem+env(safe-area-inset-bottom))] md:bottom-6 md:right-5"
>
  <a
    href={PHONE_TEL}
    class="flex min-h-10 items-center justify-center rounded-full bg-brand-accent px-4 text-sm font-bold text-brand-cream transition-colors hover:bg-brand-text-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
  >
    Call
  </a>
  <a href={MAPS_DIRECTIONS_URL} class={seg}>Map</a>
  <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class={seg}>Chat</a>
</nav>
