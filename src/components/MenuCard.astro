---
import FoodImage from './FoodImage.astro';
import DishImage from './menu/DishImage.astro';
import { isVerifiedImage } from '../lib/menu.js';
import { formatPrice } from '../lib/menu.js';

interface Props {
  name: string;
  price: string;
  category: string;
  description?: string;
  imageKey?: string;
  image?: string;
  imageThumb?: string;
  imageStatus?: string;
}

const { name, price, category, description, imageKey = 'karahi', image, imageThumb, imageStatus } = Astro.props;
const verifiedDish = isVerifiedImage({ image, imageStatus });
---

<article class="group overflow-hidden rounded-2xl border border-brand-accent/20 bg-white shadow-[0_2px_12px_-4px_rgba(7,28,20,0.12)] transition-all duration-300 hover:-translate-y-1 hover:border-brand-accent/60 hover:shadow-[0_12px_28px_-8px_rgba(7,28,20,0.2)]">
  <div class="aspect-[4/3] overflow-hidden bg-brand-green">
    {verifiedDish ? (
      <DishImage
        src={image}
        thumbSrc={imageThumb}
        alt={name}
        verified={true}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px"
        imgClass="transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <FoodImage imageKey={imageKey} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px" imgClass="transition-transform duration-500 group-hover:scale-105" iconSize={64} />
    )}
  </div>
  <div class="p-6">
    <span class="font-sans text-label font-semibold uppercase tracking-widest text-brand-accent">{category}</span>
    <h3 class="mt-2 font-display text-2xl font-medium text-brand-text-dark">{name}</h3>
    {description && <p class="mt-1 font-sans text-sm text-brand-text-muted">{description}</p>}
    <p class="mt-3 font-display text-lg font-semibold text-brand-accent" dir="ltr">{formatPrice(price)}</p>
  </div>
</article>
