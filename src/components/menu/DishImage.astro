---
interface Props {
  src?: string;
  thumbSrc?: string;
  alt: string;
  verified?: boolean;
  eager?: boolean;
  sizes?: string;
  imgClass?: string;
  iconSize?: number;
  /** 'cover' (default) fills the frame — right for plated food photography.
      'product' is for white-background product shots (bottles/cans): the
      photo is inset and letterboxed on a dark backdrop instead of being
      cropped/stretched to fill, so a studio cutout doesn't look distorted
      next to the site's full-bleed food photos. */
  fit?: 'cover' | 'product';
}

const {
  src = '',
  thumbSrc = '',
  alt,
  verified = false,
  eager = false,
  sizes = '(max-width: 640px) 40vw, 240px',
  imgClass = '',
  iconSize = 40,
  fit = 'cover',
} = Astro.props;

const showPhoto = verified && Boolean(src);
const fullSrc = src;
const smallSrc = thumbSrc || src;
---

{showPhoto ? (
  fit === 'product' ? (
    <div class={`flex h-full w-full items-center justify-center bg-brand-dark p-4 ${imgClass}`}>
      <img
        src={smallSrc}
        srcset={thumbSrc && src !== thumbSrc ? `${smallSrc} 480w, ${fullSrc} 960w` : undefined}
        sizes={sizes}
        alt={alt}
        width="960"
        height="960"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-contain object-center"
      />
    </div>
  ) : (
  <img
    src={smallSrc}
    srcset={thumbSrc && src !== thumbSrc ? `${smallSrc} 480w, ${fullSrc} 960w` : undefined}
    sizes={sizes}
    alt={alt}
    width="960"
    height="720"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class={`h-full w-full object-cover object-center ${imgClass}`}
  />
  )
) : (
  <div class={`flex h-full w-full flex-col items-center justify-center bg-gradient-to-br from-brand-mid via-brand-green to-brand-dark ${imgClass}`}>
    <svg width={iconSize} height={iconSize} viewBox="0 0 40 40" fill="none" aria-hidden="true" class="opacity-40">
      <path d="M8 20a12 12 0 0024 0" stroke="#F6F0DF" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M6 20h28" stroke="#F6F0DF" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M15 9c-1.4-1.6-1.4-3 0-4.6M20 8c-1.4-1.6-1.4-3 0-4.6M25 9c-1.4-1.6-1.4-3 0-4.6" stroke="#F6F0DF" stroke-width="1" stroke-linecap="round"/>
    </svg>
    <span class="mt-1.5 px-2 text-center font-sans text-[9px] font-semibold uppercase tracking-[0.14em] text-brand-cream/70">Image coming soon</span>
  </div>
)}
