---
interface Props {
  title: string;
  text: string;
  icon: string;
}

const { title, text, icon } = Astro.props;
---

<article class="reveal rounded-2xl border border-brand-accent/20 bg-white p-7 text-center shadow-[0_2px_16px_-6px_rgba(7,28,20,0.1)] transition-all duration-300 hover:-translate-y-1 hover:border-brand-accent/45 hover:shadow-[0_14px_28px_-10px_rgba(7,28,20,0.16)]">
  <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-brand-accent/35 bg-brand-cream text-brand-accent">
    {icon === 'food' && (
      <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M8 20a12 12 0 0024 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M6 20h28" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M15 9c-1.4-1.6-1.4-3 0-4.6M20 8c-1.4-1.6-1.4-3 0-4.6M25 9c-1.4-1.6-1.4-3 0-4.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    )}
    {icon === 'mosque' && (
      <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M11 34V21a9 9 0 0118 0v13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M7 34h26" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="20" cy="9" r="1.8" fill="currentColor"/>
      </svg>
    )}
    {icon === 'parking' && (
      <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M7 24l3-8a3 3 0 013-2h14a3 3 0 013 2l3 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="5" y="24" width="30" height="7" rx="2" stroke="currentColor" stroke-width="1.8"/>
        <circle cx="12" cy="31" r="2" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="28" cy="31" r="2" stroke="currentColor" stroke-width="1.6"/>
      </svg>
    )}
    {icon === 'family' && (
      <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <circle cx="15" cy="13" r="5" stroke="currentColor" stroke-width="1.8"/>
        <circle cx="27" cy="15" r="4" stroke="currentColor" stroke-width="1.8"/>
        <path d="M6 34c0-6.5 4-11 9-11s9 4.5 9 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M23 24c3.5 0 7 3 7 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    )}
  </div>
  <h3 class="mt-5 font-display text-xl font-semibold text-brand-text-dark">{title}</h3>
  <p class="mt-2 font-sans text-sm leading-relaxed text-brand-text-muted">{text}</p>
</article>
